---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";
import { isPublished, toSearchEntry } from "@lib/content";

const posts = (await getCollection("blog")).filter(isPublished);

const projects = (await getCollection("work")).filter(isPublished);

const data = [...posts, ...projects].map(toSearchEntry);
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <h1 class="animate page-heading">
      {SEARCH.TITLE}
    </h1>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} />
    </div>
  </BottomLayout>
</PageLayout>
