---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE } from "@consts";
---

<PageLayout
    title={`404 - Page Not Found | ${SITE.TITLE}`}
    description="The page you are looking for does not exist."
>
    <!-- tsParticles Background -->
    <script is:inline src="/js/tsparticles.bundle.min.js"></script>
    <script is:inline src="/js/bg.js"></script>
    <div
        id="tsparticles"
        class="fixed inset-0 z-0 bg-[#050505] pointer-events-none"
    >
    </div>

    <style>
        #tsparticles {
            background-image: url("");
            background-repeat: no-repeat;
            background-size: cover;
            background-position: 50% 50%;
        }
    </style>

    <!-- Main Content -->
    <section
        class="relative min-h-[85vh] flex items-center justify-center p-4 z-10"
    >
        <div
            class="backdrop-blur-md bg-white/5 border border-white/10 rounded-2xl p-12 md:p-16 max-w-xl w-full text-center shadow-2xl space-y-10"
        >
            <!-- 404 Heading -->
            <h1 class="text-8xl font-bold text-white tracking-tight">404</h1>

            <!-- Message -->
            <h2 class="text-2xl font-medium text-white/80">Page Not Found</h2>

            <!-- Path Display -->
            <div
                class="font-mono text-lg text-white/60 bg-black/20 px-4 py-2 rounded inline-block border border-white/5"
            >
                ➜ {Astro.url.pathname}
            </div>

            <!-- Home Button (Exact Match from index.astro) -->
            <div>
                <a
                    href="/"
                    data-pressable="true"
                    class="inline-block py-2 px-6 rounded truncate text-xs md:text-sm lg:text-base bg-white text-black hover:scale-105 hover:shadow-[0_0_20px_rgba(255,255,255,0.4)] transition-all duration-300 ease-out will-change-transform backface-visibility-hidden font-medium"
                >
                    Home
                </a>
            </div>
        </div>
    </section>
</PageLayout>
