---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Timeline from "@components/Timeline.astro";
import { SITE } from "@consts";
import { experience, education, certifications, projects } from "../lib/cv-data";
import CVDownloadButton from "../components/CVDownloadButton.astro";
---

<PageLayout title="About Me" description={SITE.DESCRIPTION}>
    <Container size="md">
        <div class="space-y-24 mt-32 pb-24">
            <!-- Intro Section -->
            <section class="animate space-y-8">
                <h1
                    class="text-3xl font-bold text-neutral-900 dark:text-neutral-100"
                >
                    About Me
                </h1>

                <div
                    class="space-y-4 text-neutral-600 dark:text-neutral-400 leading-relaxed text-lg"
                >
                    <p>
                        DevOps &amp; Cloud Engineer with 4+ years of infrastructure and
                        platform engineering experience. Specialized in high availability
                        and hybrid cloud automation - focused on building reliable
                        production platforms across Azure and on-prem virtualization,
                        applying Infrastructure as Code (IaC) principles to keep
                        environments predictable, versioned, and auditable.
                    </p>

                    <p>
                        Kubernetes and GitOps with Argo CD are at the center of delivery,
                        supported by CI/CD pipelines in GitLab and GitHub, Terraform and
                        Ansible for automation, and Prometheus and Grafana for
                        observability. Published IEEE researcher (MIPRO 2025). RHCE certified.
                    </p>
                </div>
            </section>

            <!-- Experience Section -->
            <section class="animate space-y-8">
                <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-4">
                    <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200">
                        Experience
                    </h2>
                    <CVDownloadButton variant="text" />
                </div>
                <Timeline items={experience} />
            </section>

            <!-- Projects Section -->
            <section class="animate space-y-8">
                <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4">
                    Projects
                </h2>
                <div class="space-y-3">
                    {projects.map((proj) => (
                        <a
                            href={proj.url}
                            data-pressable="true"
                            class="mac-surface group flex items-start justify-between gap-4 px-5 py-4 rounded-lg transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5"
                        >
                            <div class="min-w-0 space-y-1">
                                <h3 class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-black dark:group-hover:text-white transition-colors leading-snug">
                                    {proj.title}
                                </h3>
                                <p class="text-sm text-neutral-500 dark:text-neutral-400">{proj.date}</p>
                                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                                    {proj.summary}
                                </p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1 text-neutral-300 dark:text-neutral-700 group-hover:text-black dark:group-hover:text-white transition-colors">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                <polyline points="15 3 21 3 21 9" />
                                <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                        </a>
                    ))}
                </div>
            </section>

            <!-- Education Section -->
            <section class="animate space-y-8">
                <h2
                    class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4"
                >
                    Education
                </h2>
                <Timeline items={education} variant="education" />
            </section>

            <!-- Certifications Section -->
            <section class="animate space-y-8">
                <h2
                    class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4"
                >
                    Certifications
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {
                        certifications.map((cert) => (
                            <a
                                href={cert.link}
                                data-pressable="true"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mac-surface group relative flex flex-col p-6 rounded-lg transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 overflow-hidden"
                            >
                                <div class="flex items-start justify-between mb-4">
                                    <div class="p-2.5 rounded-lg bg-neutral-100 dark:bg-white/10 text-neutral-900 dark:text-white transition-colors duration-200">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="22"
                                            height="22"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <>
                                                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.74Z" />
                                                <path d="m9 12 2 2 4-4" />
                                            </>
                                        </svg>
                                    </div>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-neutral-300 dark:text-neutral-700 group-hover:text-black dark:group-hover:text-white transition-colors"
                                    >
                                        <>
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                            <polyline points="15 3 21 3 21 9" />
                                            <line
                                                x1="10"
                                                y1="14"
                                                x2="21"
                                                y2="3"
                                            />
                                        </>
                                    </svg>
                                </div>

                                <h3 class="font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-1 group-hover:text-black dark:group-hover:text-white transition-colors">
                                    {cert.name}
                                </h3>

                                <div class="mt-auto pt-4 flex flex-col gap-1 text-sm text-neutral-500 font-medium">
                                    <p>Issued: {cert.issued}</p>
                                    {cert.expires && (
                                        <p
                                            class={
                                                cert.expires ===
                                                    "No Expiration" ||
                                                new Date(cert.expires) >
                                                    new Date() // Future date = active
                                                    ? "text-green-500 dark:text-green-400 flex items-center gap-1.5"
                                                    : "text-red-500/80 dark:text-red-400/80 flex items-center gap-1.5"
                                            }
                                        >
                                            Expires: {cert.expires}
                                        </p>
                                    )}
                                </div>
                            </a>
                        ))
                    }
                </div>
                
                <div class="pt-16 pb-4 flex justify-center">
                    <CVDownloadButton variant="primary" />
                </div>
            </section>
        </div>
    </Container>
</PageLayout>
