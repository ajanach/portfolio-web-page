---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Timeline from "@components/Timeline.astro";
import { SITE } from "@consts";

const experience = [
    {
        date: "Mar 2024 — Present",
        title: "DevOps Engineer",
        company: "SICK MOBILISIS d.o.o.",
        points: [
            "Plan, develop, deploy, and maintain various software solutions, incorporating security best practices.",
            "Monitor performance and manage infrastructure to meet specified requirements (Prometheus, Grafana, Loki).",
            "Design and implement CI/CD pipelines based on project requirements.",
            "Design and deploy highly available infrastructure using cloud services, primarily Azure.",
            "Write Infrastructure as Code (IaC) using Terraform to streamline setup replication across multiple development environments.",
            "Ensure solutions are designed with a focus on performance, scalability, and operability.",
            "Collaborate on projects involving Kubernetes, Terraform, Ansible, Azure Cloud, ArgoCD, GitLab, Linux, Bash scripting, etc.",
            "Create Terraform files for infrastructure provisioning and YAML manifest files for Kubernetes service deployment, maintaining Kubernetes in the desired state.",
        ],
    },
    {
        date: "Jul 2023 — Feb 2024",
        title: "DevOps Engineer (Internship)",
        company: "SICK MOBILISIS d.o.o.",
        points: [
            "Collaborated on projects involving Kubernetes, Terraform, Ansible, Azure Cloud, ArgoCD, GitLab, Linux, Bash scripting, and more.",
            "Execute projects that are highly available and span technologies like Kubernetes, Terraform, Ansible, Azure Cloud, ArgoCD, GitLab, Linux, Bash scripting, etc.",
        ],
    },
    {
        date: "Dec 2021 — Jun 2023",
        title: "Junior System Engineer",
        company: "Combis d.o.o.",
        points: [
            "Checking application/service logs, resource usage, monitoring backup execution.",
            "Remote diagnostics of problems and user support for problem resolution.",
            "Monitoring, administration, and troubleshooting of IT systems.",
            "System configuration, installing additional programs on equipment, and user education.",
            "Analysis of user needs and solution planning.",
            "Tech stack: Linux Administration (Bash, Security, Storage, Podman, SSH), Windows (ADDS, DNS, DHCP, Exchange), Hyper-V, vSphere, Veeam.",
        ],
    },
    {
        date: "Oct 2018 — Present",
        title: "Web Administrator",
        company: "Freelance",
        points: [
            "Design, develop, and administer cloud-based WordPress websites (using Apache/httpd) to enhance the online presence of local businesses.",
            "Leveraging cloud infrastructure, I create scalable and customizable websites that optimize performance and user experience.",
            "Tech stack: Wordpress, PHP, MariaDB, Apache/httpd, Google Analytics, SEO, E-mail service.",
        ],
    },
    {
        date: "Sep 2017 — Sep 2019",
        title: "Information Technology Instructor",
        company: "Enter Koprivnica d.o.o.",
        points: [
            "Organizing and conducting IT workshops aimed at educating both young and adult populations about the importance of IT education.",
            "Tech stack: mBot, Micro:bit, Arduino, C++.",
        ],
    },
];

const education = [
    {
        date: "2022 — 2024",
        title: "Master's Degree",
        company:
            "Faculty of Informatics and Digital Technologies, University of Rijeka",
        points: [
            "<strong class='font-bold'>Master's Thesis:</strong> Comparison of Orchestration Systems for Microservices Applications <a href='https://janach.cloud/work/master/masters-thesis-comparison-of-orchestration-systems-for-microservices/' target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-1 px-2 py-0.5 ml-2 text-[10px] font-black uppercase tracking-wider bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 rounded hover:bg-neutral-200 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white transition-all no-underline active:scale-95'>View ↗</a>",
            "<strong class='font-bold'>Published Research (MIPRO 2025 / IEEE):</strong> 'A Decision-Making Framework for Evaluating Orchestration Systems in Microservices Applications'. Co-authored with Rok Piltaver. <a href='https://janach.cloud/work/master/orchestration-decision-framework-mipro-2025/' target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-1 px-2 py-0.5 ml-2 text-[10px] font-black uppercase tracking-wider bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 rounded hover:bg-neutral-200 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white transition-all no-underline active:scale-95'>View ↗</a>",
        ],
    },
    {
        date: "2018 — 2021",
        title: "Bachelor's Degree",
        company: "Algebra Bernays University",
        points: [
            "<strong class='font-bold'>Final Thesis:</strong> Windows Computer Administration using Microsoft Endpoint Configuration Manager in the Microsoft Azure Cloud <a href='https://janach.cloud/work/bachelor/windows-computer-administration-using-mecm-in-azure-final-thesis/' target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-1 px-2 py-0.5 ml-2 text-[10px] font-black uppercase tracking-wider bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 rounded hover:bg-neutral-200 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white transition-all no-underline active:scale-95'>View ↗</a>",
        ],
    },
];

const certifications = [
    {
        name: "Red Hat Certified Engineer (RHCE)",
        issued: "April 2025",
        expires: "April 2028",
        link: "https://www.credly.com/badges/f51f0b15-782f-4302-955d-98b4b46a0d07/public_url",
    },
    {
        name: "Red Hat Certified System Administrator (RHCSA)",
        issued: "April 2022",
        expires: "April 2028",
        link: "https://www.credly.com/badges/00733b40-0d36-48cc-94b0-363368f49a2d/public_url",
    },
    {
        name: "Microsoft Certified: Azure Fundamentals (AZ-900)",
        issued: "July 2022",
        expires: "No Expiration",
        link: "https://www.credly.com/badges/8982b5e9-72f2-4312-ad69-6b31375a60d6/public_url",
    },
    {
        name: "MTA: Networking Fundamentals",
        issued: "June 2019",
        expires: "No Expiration",
        link: "https://www.credly.com/badges/7ed2a90b-7d34-4164-9784-999563f60a62",
    },
    {
        name: "MTA: Windows Operating System Fundamentals",
        issued: "June 2019",
        expires: "No Expiration",
        link: "https://www.credly.com/badges/b69bd791-da70-44c6-821c-f62750d30a9b",
    },
];
---

<PageLayout title="About Me" description={SITE.DESCRIPTION}>
    <Container size="md">
        <div class="space-y-24 mt-32 pb-24">
            <!-- Intro Section -->
            <section class="animate space-y-8">
                <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
                    About Me
                </h1>

                <div class="space-y-4 text-neutral-600 dark:text-neutral-400 leading-relaxed text-lg">
                    <p>
                    DevOps &amp; Cloud Engineer specialized in high availability and hybrid cloud automation. 
                    Focused on building reliable production platforms across Azure and on-prem virtualization, applying 
                    Infrastructure as Code (IaC) principles to keep environments predictable, versioned, and auditable - from 
                    core infrastructure to Kubernetes platform components.
                    </p>

                    <p>
                    Kubernetes and GitOps with Argo CD are at the center of delivery, supported by CI/CD pipelines in GitLab and GitHub 
                    to reduce lead time and ship changes safely. The standard stack includes Terraform and Ansible for automation, 
                    Prometheus/Grafana for observability, and Vault-style secrets management for security.
                    </p>
                </div>
            </section>

            <!-- Experience Section -->
            <section class="animate space-y-8">
                <h2
                    class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4"
                >
                    Experience
                </h2>
                <Timeline items={experience} />
            </section>

            <!-- Education Section -->
            <section class="animate space-y-8">
                <h2
                    class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4"
                >
                    Education
                </h2>
                <Timeline items={education} />
            </section>

            <!-- Certifications Section -->
            <section class="animate space-y-8">
                <h2
                    class="text-2xl font-semibold text-neutral-900 dark:text-neutral-200 border-b border-neutral-200 dark:border-neutral-800 pb-4"
                >
                    Certifications
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {
                        certifications.map((cert) => (
                            <a
                                href={cert.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group relative flex flex-col p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-all duration-300 hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-lg overflow-hidden"
                            >
                                <div class="flex items-start justify-between mb-4">
                                    <div class="p-2.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white group-hover:scale-110 transition-transform duration-300">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="22"
                                            height="22"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <>
                                                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.74Z" />
                                                <path d="m9 12 2 2 4-4" />
                                            </>
                                        </svg>
                                    </div>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-neutral-300 dark:text-neutral-700 group-hover:text-black dark:group-hover:text-white transition-colors"
                                    >
                                        <>
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                            <polyline points="15 3 21 3 21 9" />
                                            <line
                                                x1="10"
                                                y1="14"
                                                x2="21"
                                                y2="3"
                                            />
                                        </>
                                    </svg>
                                </div>

                                <h3 class="font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-1 group-hover:text-black dark:group-hover:text-white transition-colors">
                                    {cert.name}
                                </h3>

                                <div class="mt-auto pt-4 flex flex-col gap-1 text-sm text-neutral-500 font-medium">
                                    <p>Issued: {cert.issued}</p>
                                    {cert.expires && (
                                        <p class="text-green-500 dark:text-green-400 flex items-center gap-1.5" 
        : "text-red-500/80 dark:text-red-400/80">
                                            Expires: {cert.expires}
                                        </p>
                                    )}
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>
        </div>
    </Container>
</PageLayout>
