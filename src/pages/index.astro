---
import PageLayout from "@layouts/PageLayout.astro";

import StackCard from "@components/StackCard.astro";
const { SITE } = await import("@consts");

const stack = {
  Orchestration: [
    {
      text: "Kubernetes",
      icon: "/stack-icons/kubernetes.svg",
      href: "https://kubernetes.io",
    },
    {
      text: "Podman",
      icon: "/stack-icons/podman.svg",
      href: "https://podman.io",
    },
    {
      text: "Docker",
      icon: "/stack-icons/docker.svg",
      href: "https://www.docker.com",
    },
    {
      text: "ArgoCD",
      icon: "/stack-icons/argocd.svg",
      href: "https://argoproj.github.io/cd/",
    },
  ],
  "Automation & CI/CD": [
    {
      text: "Terraform",
      icon: "/stack-icons/terraform.svg",
      href: "https://www.terraform.io",
    },
    {
      text: "Ansible",
      icon: "/stack-icons/ansible.svg",
      href: "https://www.ansible.com",
    },
    {
      text: "GitLab CI/CD",
      icon: "/stack-icons/gitlab.svg",
      href: "https://about.gitlab.com",
    },
    {
      text: "GitHub Actions",
      icon: "/stack-icons/github-actions.svg",
      href: "https://github.com/features/actions",
    },
  ],
  Infrastructure: [
    {
      text: "Azure",
      icon: "/stack-icons/azure.svg",
      href: "https://azure.microsoft.com",
    },
    {
      text: "VMware",
      icon: "/stack-icons/vmware.svg",
      href: "https://www.vmware.com",
    },
    {
      text: "Hyper-V",
      icon: "/stack-icons/hyper-v.svg",
      href: "https://www.microsoft.com",
    },
    {
      text: "Proxmox",
      icon: "/stack-icons/proxmox.svg",
      href: "https://www.proxmox.com",
    },
    {
      text: "Linux",
      icon: "/stack-icons/linux.svg",
      href: "https://www.linux.org",
    },
    {
      text: "Windows",
      icon: "/stack-icons/windows.svg",
      href: "https://www.microsoft.com",
    },
  ],
  "Observability & Security": [
    {
      text: "Prometheus",
      icon: "/stack-icons/prometheus.svg",
      href: "https://prometheus.io",
    },
    {
      text: "Grafana",
      icon: "/stack-icons/grafana.svg",
      href: "https://grafana.com",
    },
    {
      text: "Grafana Alloy",
      icon: "/stack-icons/grafana-alloy.svg",
      href: "https://grafana.com/oss/alloy-opentelemetry-collector/",
    },
    {
      text: "Loki",
      icon: "/stack-icons/loki.svg",
      href: "https://grafana.com/oss/loki/",
    },
    {
      text: "HashiCorp Vault",
      icon: "/stack-icons/vault.svg",
      href: "https://www.vaultproject.io",
    },
  ],
};

const selectedWork = [
  {
    category: "Platform Engineering",
    title: "Azure AKS GitOps Platform",
    summary:
      "Production-ready AKS platform with GitOps delivery, layered security, and complete observability.",
    href: "/work/side-projects/azure-aks-gitops-boilerplate/",
  },
  {
    category: "Hybrid Infrastructure",
    title: "Hybrid Cloud Homelab",
    summary:
      "Reproducible OCI and on-prem platform running 22+ rootless services at zero cloud cost.",
    href: "/work/side-projects/homelab-hybrid-cloud-automation/",
  },
];
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- tsParticles Background (self-hosted to avoid tracking prevention warnings) -->
  <script is:inline src="/js/tsparticles.bundle.min.js"></script>
  <script is:inline src="/js/bg.js"></script>
  <div id="tsparticles" class="fixed inset-0 z-0 bg-[#050505]"></div>

  <style>
    #tsparticles {
      background-image: url("");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: 50% 50%;
    }
  </style>

  <section class="home-hero relative w-full z-10 pointer-events-none">
    <div
      class="animate absolute h-full w-full flex items-center justify-center"
    >
      <div class="relative w-full h-full flex items-center justify-center">
        <div class="hero-content w-full text-center pointer-events-auto">
          <div
            class="profile-frame animated relative mx-auto rounded-full overflow-hidden border border-white/20"
          >
            <img
              src="/profile.webp"
              alt="Profile Picture"
              width="640"
              height="640"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <p
            class="animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-white"
          >
            Antonio Janach
          </p>
          <p
            class="animated mx-auto max-w-2xl text-sm md:text-base lg:text-lg opacity-75 text-white"
          >
            DevOps & Cloud Engineer specialized in high availability and hybrid
            cloud automation.
          </p>
          <div
            id="ctaButtons"
            class="animated flex flex-wrap gap-4 justify-center mt-5"
          >
            <a
              href="/about"
              data-pressable="true"
              class="py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-white text-black hover:scale-105 hover:shadow-[0_0_20px_rgba(255,255,255,0.4)] transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              About
            </a>
            <a
              href="/contact"
              data-pressable="true"
              class="reveal-card py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-white/20 text-white hover:text-white transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              Contact
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="explore-cue absolute inset-x-0 mx-auto w-fit flex flex-col items-center gap-1.5 text-white/75 pointer-events-none select-none"
    >
      <span
        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.22em]"
      >
        Explore
      </span>
      <span class="explore-arrow flex size-5 items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </span>
    </div>
  </section>

  <div
    id="technical-stack"
    class="stack-section relative z-10 bg-transparent"
  >
    <div class="mx-auto max-w-screen-md px-5 pb-16 sm:pb-20">
      <!-- Tech Stack Section -->
      <section class="scroll-mt-20 border-t border-black/10 pt-16 dark:border-white/10 sm:pt-20">
        <div class="space-y-10">
          <p
            class="font-semibold text-black dark:text-white text-2xl sm:text-3xl text-center"
          >
            Technical Stack
          </p>

          <div class="space-y-10">
            {
              Object.entries(stack).map(([category, items]) => (
                <div class="space-y-3">
                  <p class="text-left text-[11px] font-bold uppercase tracking-widest text-neutral-600 dark:text-neutral-400">
                    {category}
                  </p>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 place-items-center">
                    {items.map((item) => (
                      <StackCard
                        text={item.text}
                        icon={item.icon}
                        href={item.href}
                      />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="mt-20 border-t border-black/10 pt-16 dark:border-white/10">
        <div class="mb-7 flex items-end justify-between gap-4">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-neutral-600 dark:text-neutral-400">
              Built in practice
            </p>
            <h2 class="mt-2 text-2xl font-semibold text-black dark:text-white sm:text-3xl">
              Selected Work
            </h2>
          </div>
          <a
            href="/work"
            data-pressable="true"
            class="shrink-0 text-sm font-medium text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white"
          >
            View all work
          </a>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            selectedWork.map((project) => (
              <a
                href={project.href}
                data-pressable="true"
                class="mac-surface group flex min-h-52 flex-col rounded-lg p-5 transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-4">
                  <p class="text-[11px] font-bold uppercase tracking-widest text-neutral-600 dark:text-neutral-400">
                    {project.category}
                  </p>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="shrink-0 text-black/35 transition-[color,transform] duration-200 group-hover:translate-x-0.5 group-hover:text-black dark:text-white/35 dark:group-hover:text-white"
                  >
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </div>
                <h3 class="mt-auto pt-10 text-lg font-semibold leading-snug text-black dark:text-white">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-black/60 dark:text-white/60">
                  {project.summary}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .home-hero {
    height: 100vh;
    height: 100svh;
    min-height: 35.5rem;
  }

  @supports (height: 100dvh) {
    .home-hero {
      height: 100dvh;
    }
  }

  .hero-content {
    padding: 5rem 1.25rem 6.5rem;
  }

  .profile-frame {
    width: clamp(11.5rem, 52vmin, 16rem);
    aspect-ratio: 1;
    margin-bottom: clamp(1rem, 3vh, 1.5rem);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.55),
      0 0 0 6px rgba(255, 255, 255, 0.025),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .explore-cue {
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    animation: explore-cue 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    will-change: transform;
  }

  @keyframes explore-cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-height: 42rem) {
    .home-hero {
      min-height: 32rem;
    }

    .hero-content {
      padding-top: 4.5rem;
      padding-bottom: 5.5rem;
    }

    .profile-frame {
      width: clamp(10.5rem, 31vh, 12.5rem);
      margin-bottom: 0.875rem;
    }

    .explore-cue {
      gap: 0.25rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-cue {
      animation: none;
    }
  }
</style>
