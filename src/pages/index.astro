---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- tsParticles Background -->
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js"
  ></script>
  <script is:inline src="/js/bg.js"></script>
  <div id="tsparticles" class="fixed inset-0 z-0 bg-[#050505]"></div>

  <style>
    #tsparticles {
      background-image: url("");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: 50% 50%;
    }
  </style>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("show");
        }
      });
    });

    const hiddenElements = document.querySelectorAll(".animate");
    hiddenElements.forEach((el) => observer.observe(el));
  </script>

  <section class="relative h-screen w-full z-10 pointer-events-none">
    <div
      class="animate absolute h-full w-full flex items-center justify-center"
    >
      <div class="relative w-full h-full flex items-center justify-center">
        <div class="p-5 text-center pointer-events-auto">
          <div
            class="animated relative w-64 h-64 mx-auto mb-6 rounded-full overflow-hidden border border-white/20 shadow-[0_0_15px_rgba(255,255,255,0.1)]"
          >
            <img
              src="/profile.png"
              alt="Profile Picture"
              class="w-full h-full object-cover"
            />
          </div>
          <p
            class="animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-white"
          >
            Antonio Janach
          </p>
          <p
            class="animated text-sm md:text-base lg:text-lg opacity-75 text-white"
          >
            DevOps & Cloud Engineer specialized in high availability and hybrid
            cloud automation.
          </p>
          <div
            id="ctaButtons"
            class="animated flex flex-wrap gap-4 justify-center mt-5"
          >
            <a
              href="/about"
              class="py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-white text-black hover:scale-105 hover:shadow-[0_0_20px_rgba(255,255,255,0.4)] transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              About
            </a>
            <a
              href="/work"
              class="reveal-card py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-white/20 text-white hover:text-white transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              Work
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-transparent z-10">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">
      <!-- Tech Stack Section -->
      <section class="animate mt-12">
        <section class="animate mt-12">
          <div class="space-y-8">
            <p
              class="font-semibold text-black dark:text-white uppercase tracking-widest text-xl text-center"
            >
              Technical Stack
            </p>

            <div class="space-y-8">
              {
                Object.entries(stack).map(([category, items]) => (
                  <div class="space-y-3">
                    <p class="text-[10px] font-bold uppercase opacity-50 tracking-widest text-center">
                      {category}
                    </p>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 place-items-center">
                      {items.map((item) => (
                        <StackCard
                          text={item.text}
                          icon={item.icon}
                          href={item.href}
                        />
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      </section>
    </div>
  </div>
</PageLayout>
