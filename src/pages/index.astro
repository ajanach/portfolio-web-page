---
import PageLayout from "@layouts/PageLayout.astro";

import StackCard from "@components/StackCard.astro";
const { SITE } = await import("@consts");

const stack = {
  Orchestration: [
    {
      text: "Kubernetes",
      icon: "https://cdn.simpleicons.org/kubernetes/326CE5",
      href: "https://kubernetes.io",
    },
    {
      text: "Podman",
      icon: "https://cdn.simpleicons.org/podman/892CA0",
      href: "https://podman.io",
    },
    {
      text: "Docker",
      icon: "https://cdn.simpleicons.org/docker/2496ED",
      href: "https://www.docker.com",
    },
    {
      text: "ArgoCD",
      icon: "https://cdn.simpleicons.org/argo/EF7B4D",
      href: "https://argoproj.github.io/cd/",
    },
  ],
  "Automation & CI/CD": [
    {
      text: "Terraform",
      icon: "https://cdn.simpleicons.org/terraform/7B42BC",
      href: "https://www.terraform.io",
    },
    {
      text: "Ansible",
      icon: "https://cdn.simpleicons.org/ansible/EE0000",
      href: "https://www.ansible.com",
    },
    {
      text: "GitLab CI/CD",
      icon: "https://cdn.simpleicons.org/gitlab/FC6D26",
      href: "https://about.gitlab.com",
    },
    {
      text: "GitHub Actions",
      icon: "https://cdn.simpleicons.org/githubactions/2088FF",
      href: "https://github.com/features/actions",
    },
  ],
  Infrastructure: [
    {
      text: "Azure",
      icon: "https://www.vectorlogo.zone/logos/microsoft_azure/microsoft_azure-icon.svg",
      href: "https://azure.microsoft.com",
    },
    {
      text: "VMware",
      icon: "https://cdn.simpleicons.org/vmware/607078",
      href: "https://www.vmware.com",
    },
    {
      text: "Hyper-V",
      icon: "https://api.iconify.design/simple-icons:microsoft.svg?color=%230078d4",
      href: "https://www.microsoft.com",
    },
    {
      text: "Proxmox",
      icon: "https://cdn.simpleicons.org/proxmox/E57000",
      href: "https://www.proxmox.com",
    },
    {
      text: "Linux",
      icon: "https://www.vectorlogo.zone/logos/linux/linux-icon.svg",
      href: "https://www.linux.org",
    },
    {
      text: "Windows",
      icon: "https://www.vectorlogo.zone/logos/microsoft/microsoft-icon.svg",
      href: "https://www.microsoft.com",
    },
  ],
  "Observability & Security": [
    {
      text: "Prometheus",
      icon: "https://cdn.simpleicons.org/prometheus/E6522C",
      href: "https://prometheus.io",
    },
    {
      text: "Grafana",
      icon: "https://cdn.simpleicons.org/grafana/F47A20",
      href: "https://grafana.com",
    },
    {
      text: "Grafana Alloy",
      icon: "https://cdn.simpleicons.org/grafana/F46800",
      href: "https://grafana.com/oss/alloy-opentelemetry-collector/",
    },
    {
      text: "Loki",
      icon: "https://grafana.com/static/img/logos/logo-loki.svg",
      href: "https://grafana.com/oss/loki/",
    },
    {
      text: "HashiCorp Vault",
      icon: "https://cdn.simpleicons.org/vault/000000",
      href: "https://www.vaultproject.io",
    },
  ],
};
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- tsParticles Background (self-hosted to avoid tracking prevention warnings) -->
  <script is:inline src="/js/tsparticles.bundle.min.js"></script>
  <script is:inline src="/js/bg.js"></script>
  <div id="tsparticles" class="fixed inset-0 z-0 bg-[#050505]"></div>

  <style>
    #tsparticles {
      background-image: url("");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: 50% 50%;
    }
  </style>

  <section class="home-hero relative w-full z-10 pointer-events-none">
    <div
      class="animate absolute h-full w-full flex items-center justify-center"
    >
      <div class="relative w-full h-full flex items-center justify-center">
        <div class="hero-content w-full text-center pointer-events-auto">
          <div
            class="profile-frame animated relative mx-auto rounded-full overflow-hidden border border-white/20"
          >
            <img
              src="/profile.png"
              alt="Profile Picture"
              class="w-full h-full object-cover"
            />
          </div>
          <p
            class="animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-white"
          >
            Antonio Janach
          </p>
          <p
            class="animated mx-auto max-w-2xl text-sm md:text-base lg:text-lg opacity-75 text-white"
          >
            DevOps & Cloud Engineer specialized in high availability and hybrid
            cloud automation.
          </p>
          <div
            id="ctaButtons"
            class="animated flex flex-wrap gap-4 justify-center mt-5"
          >
            <a
              href="/about"
              class="py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-white text-black hover:scale-105 hover:shadow-[0_0_20px_rgba(255,255,255,0.4)] transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              About
            </a>
            <a
              href="/work"
              class="reveal-card py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-white/20 text-white hover:text-white transition-all duration-300 ease-out will-change-transform backface-visibility-hidden"
            >
              Work
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="explore-cue absolute inset-x-0 mx-auto w-fit flex flex-col items-center gap-1.5 text-white/75 pointer-events-none select-none"
    >
      <span
        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.22em]"
      >
        Explore
      </span>
      <span class="explore-arrow flex size-5 items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </span>
    </div>
  </section>

  <div
    id="technical-stack"
    class="stack-section relative z-10 bg-transparent"
  >
    <div class="mx-auto max-w-screen-md px-5 py-16 sm:py-20">
      <!-- Tech Stack Section -->
      <section class="animate scroll-mt-20">
        <div class="space-y-10">
          <p
            class="font-semibold text-black dark:text-white text-2xl sm:text-3xl text-center"
          >
            Technical Stack
          </p>

          <div class="space-y-10">
            {
              Object.entries(stack).map(([category, items]) => (
                <div class="space-y-3">
                  <p class="text-[11px] font-bold uppercase opacity-50 tracking-widest text-left">
                    {category}
                  </p>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 place-items-center">
                    {items.map((item) => (
                      <StackCard
                        text={item.text}
                        icon={item.icon}
                        href={item.href}
                      />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .home-hero {
    height: 100vh;
    height: 100svh;
    min-height: 35.5rem;
  }

  @supports (height: 100dvh) {
    .home-hero {
      height: 100dvh;
    }
  }

  .hero-content {
    padding: 5rem 1.25rem 6.5rem;
  }

  .profile-frame {
    width: clamp(11.5rem, 52vmin, 16rem);
    aspect-ratio: 1;
    margin-bottom: clamp(1rem, 3vh, 1.5rem);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.55),
      0 0 0 6px rgba(255, 255, 255, 0.025),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .explore-cue {
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    animation: explore-cue 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    will-change: transform;
  }

  @keyframes explore-cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-height: 42rem) {
    .home-hero {
      min-height: 32rem;
    }

    .hero-content {
      padding-top: 4.5rem;
      padding-bottom: 5.5rem;
    }

    .profile-frame {
      width: clamp(10.5rem, 31vh, 12.5rem);
      margin-bottom: 0.875rem;
    }

    .explore-cue {
      gap: 0.25rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-cue {
      animation: none;
    }
  }
</style>
