---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro";
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro";
import { isPublished } from "@lib/content";

// Create the static blog pages
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

// Get the requested post
type Props = CollectionEntry<"blog">;
const post = Astro.props;
const { title, summary } = post.data;
const hasMermaid = post.body?.includes("```mermaid") ?? false;
---

<PageLayout title={title} description={summary} mermaid={hasMermaid}>
  <TopLayout>
    <div class="animate-on-load">
      <ArticleTopLayout entry={post} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate-on-load delay-100">
      <ArticleBottomLayout entry={post} />
    </div>
  </BottomLayout>
</PageLayout>
