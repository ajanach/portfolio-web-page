---
type Props = {
  text: string;
  icon: string;
  href: string;
};

const { text, icon, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="reveal-card w-full flex items-center justify-start gap-3 px-4 py-3 border border-white/5 dark:border-white/10 rounded-lg transition-all duration-300 group bg-white/[0.03] backdrop-blur-md hover:bg-white/[0.08] hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.05)] min-h-[60px] relative overflow-hidden"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-white/[0.05] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
  >
  </div>

  <div
    class="w-8 h-8 p-1.5 bg-white rounded-md flex items-center justify-center shadow-xs flex-shrink-0"
  >
    {
      icon.startsWith("http") ||
      icon.startsWith("/") ||
      icon.startsWith("./") ? (
        <img src={icon} alt={text} class="w-full h-full object-contain" />
      ) : (
        <svg class="w-full h-full fill-current text-black">
          <use xlink:href={`/stack.svg#${icon}`} />
        </svg>
      )
    }
  </div>

  <span
    class="text-sm font-medium text-black dark:text-white leading-tight break-words"
  >
    {text}
  </span>
</a>
