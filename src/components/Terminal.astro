            const FILES = {
                "about.txt": "content",
                "contact.sh": "content",
            };

            const COMMANDS = {
                help: "Show available commands",
                about: "Who is Antonio?",
                experience: "Work history",
                education: "Academic background",
                certificates: "Professional certs",
                skills: "Tech stack",
                cv: "Download full CV",
                contact: "Get in touch",
                ls: "List files",
                cat: "Read file",
                whoami: "Show current user",
                status: "Service availability",
                neofetch: "System info",
                clear: "Clear terminal",
                exit: "Close terminal",
                sudo: "Attempt root access",
            };

            function initTerminal() {
                const overlay = document.getElementById("terminal-overlay");
                const windowEl = document.getElementById("terminal-window");
                const content = document.getElementById("terminal-content");
                const output = document.getElementById("output");
                const input = document.getElementById("terminal-input");

                // Buttons
                const closeBtn = document.getElementById("term-close-btn");
                const minimizeBtn =
                    document.getElementById("term-minimize-btn");
                const maximizeBtn =
                    document.getElementById("term-maximize-btn");
                const titlebar = document.getElementById("terminal-titlebar");

                // Toolbar
                const toolbarToggle = document.getElementById("toolbar-toggle");
                const toolbarContainer =
                    document.getElementById("toolbar-container");

                // Initialize Toggle State
                const isCollapsed =
                    localStorage.getItem("terminal_toolbar_visible") ===
                    "false";
                if (isCollapsed)
                    toolbarContainer?.classList.add("toolbar-collapsed");
                toolbarToggle?.setAttribute(
                    "aria-expanded",
                    String(!isCollapsed),
                );

                if (!overlay || !windowEl || !input) return;

                const updateMaximizeControl = () => {
                    const label = isMaximized
                        ? "Restore terminal window"
                        : "Enter full screen";
                    maximizeBtn?.setAttribute("aria-label", label);
                    maximizeBtn?.setAttribute("title", label);
                    maximizeBtn?.setAttribute(
                        "aria-pressed",
                        String(isMaximized),
                    );
                };

                updateMaximizeControl();

                // --- Core Actions ---

                function trackedTimeout(callback, delay) {
                    const id = window.setTimeout(() => {
                        if (overlay.classList.contains("hidden")) return;
                        callback();
                    }, delay);
                    activeTimeouts.push(id);
                    return id;
                }

                function clearTimeouts() {
                    activeTimeouts.forEach((id) => window.clearTimeout(id));
                    activeTimeouts = [];
                }

                function setTerminalOrigin(origin) {
                    const width = windowEl.offsetWidth;
                    const height = windowEl.offsetHeight;
                    const left = (window.innerWidth - width) / 2;
                    const top = (window.innerHeight - height) / 2;
                    const originX = Number.isFinite(origin?.x)
                        ? origin.x - left
                        : width / 2;
                    const originY = Number.isFinite(origin?.y)
                        ? origin.y - top
                        : height / 2;

                    windowEl.style.setProperty(
                        "--terminal-origin-x",
                        `${originX}px`,
                    );
                    windowEl.style.setProperty(
                        "--terminal-origin-y",
                        `${originY}px`,
                    );
                }

                function openTerminal(origin) {
                    if (isAnimating) return;
                    isAnimating = true;

                    abortController?.abort();
                    abortController = new AbortController();
                    const activeElement = document.activeElement;
                    const isVisibleTrigger = (element) => {
                        if (!(element instanceof HTMLElement)) return false;
                        const style = window.getComputedStyle(element);
                        return (
                            element.getClientRects().length > 0 &&
                            style.display !== "none" &&
                            style.visibility !== "hidden"
                        );
                    };
                    const fallbackTrigger = [
                        document.getElementById("terminal-toggle"),
                        document.getElementById("header-drawer-button"),
                    ].find(isVisibleTrigger);
                    const requestedTrigger = origin?.returnFocusId
                        ? document.getElementById(origin.returnFocusId)
                        : null;
                    lastTrigger = isVisibleTrigger(requestedTrigger)
                        ? requestedTrigger
                        : isVisibleTrigger(activeElement)
                          ? activeElement
                          : fallbackTrigger || null;

                    pageScrollY = window.scrollY;
                    document.body.style.setProperty(
                        "--terminal-page-offset",
                        `-${pageScrollY}px`,
                    );
                    document.documentElement.classList.add("terminal-open");
                    document.body.classList.add("terminal-scroll-locked");
                    overlay.classList.remove("hidden");
                    overlay.classList.add("flex");
                    overlay.setAttribute("aria-hidden", "false");
                    windowEl.classList.remove(
                        "terminal-closing",
                        "terminal-minimizing",
                        "terminal-settled",
                    );
                    setTerminalOrigin(origin);

                    requestAnimationFrame(() => {
                        overlay.classList.add("terminal-overlay-visible");
                        windowEl.classList.add("terminal-visible");

                        trackedTimeout(() => {
                            windowEl.classList.add("terminal-settled");
                            isAnimating = false;
                            if (!isBooted) bootSequence();
                            else focusInput();
                        }, 380);
                    });
                }

                function closeTerminal() {
                    if (
                        overlay.classList.contains("hidden") ||
                        windowEl.classList.contains("terminal-closing") ||
                        windowEl.classList.contains("terminal-minimizing")
                    )
                        return;
                    isAnimating = true;

                    clearTimeouts();
                    abortController?.abort();

                    closeBtn?.classList.add("control-activated");
                    windowEl.classList.remove("terminal-settled");

                    requestAnimationFrame(() => {
                        overlay.classList.remove("terminal-overlay-visible");
                        overlay.setAttribute("aria-hidden", "true");
                        windowEl.classList.remove("terminal-visible");
                        windowEl.classList.add("terminal-closing");

                        input.blur();

                        window.setTimeout(() => {
                            overlay.classList.add("hidden");
                            overlay.classList.remove("flex");
                            if (isMaximized) {
                                toggleMaximize(true);
                            }
                            windowEl.classList.remove("terminal-closing");
                            document.documentElement.classList.remove(
                                "terminal-open",
                            );
                            document.body.classList.remove(
                                "terminal-scroll-locked",
                            );
                            document.body.style.removeProperty(
                                "--terminal-page-offset",
                            );
                            window.scrollTo({
                                top: pageScrollY,
                                behavior: "instant",
                            });
                            if (input) input.value = "";
                            closeBtn?.classList.remove("control-activated");
                            isAnimating = false;
                            lastTrigger?.focus?.({ preventScroll: true });
                        }, 240);
                    });
                }

                function minimizeTerminal() {
                    if (
                        overlay.classList.contains("hidden") ||
                        windowEl.classList.contains("terminal-closing") ||
                        windowEl.classList.contains("terminal-minimizing")
                    )
                        return;
                    isAnimating = true;

                    clearTimeouts();
                    abortController?.abort();

                    minimizeBtn?.classList.add("control-activated");
                    windowEl.classList.remove("terminal-settled");
                    overlay.classList.remove("terminal-overlay-visible");
                    overlay.setAttribute("aria-hidden", "true");
                    windowEl.classList.remove(
                        "terminal-visible",
                        "terminal-maximized",
                    );
                    windowEl.classList.add("terminal-minimizing");
                    isMaximized = false;
                    updateMaximizeControl();

                    input.blur();

                    window.setTimeout(() => {
                        overlay.classList.add("hidden");
                        overlay.classList.remove("flex");
                        document.documentElement.classList.remove(
                            "terminal-open",
                        );
                        document.body.classList.remove(
                            "terminal-scroll-locked",
                        );
                        document.body.style.removeProperty(
                            "--terminal-page-offset",
                        );
                        window.scrollTo({
                            top: pageScrollY,
                            behavior: "instant",
                        });
                        windowEl.classList.remove("terminal-minimizing");
                        minimizeBtn?.classList.remove("control-activated");
                        isAnimating = false;
                        lastTrigger?.focus?.({ preventScroll: true });
                    }, 480);
                }

                function toggleMaximize(forceReset = false) {
                    if (forceReset) {
                        windowEl.classList.remove("terminal-maximized");
                        isMaximized = false;
                        updateMaximizeControl();
                        return;
                    }

                    windowEl.classList.remove("terminal-settled");
                    isMaximized = !isMaximized;
                    windowEl.classList.toggle(
                        "terminal-maximized",
                        isMaximized,
                    );
                    updateMaximizeControl();

                    setTimeout(() => focusInput(), 50);
                    trackedTimeout(
                        () => windowEl.classList.add("terminal-settled"),
                        460,
                    );
                }

                function focusInput() {
                    if (
                        document.activeElement !== input &&
                        !overlay.classList.contains("hidden")
                    ) {
                        input.focus({ preventScroll: true });
                    }
                }

                // --- Helpers ---

                function scrollToBottom() {
                    if (content) {
                        requestAnimationFrame(() => {
                            content.scrollTop = content.scrollHeight;
                        });
                    }
                }

                async function printLines(lines, delayPerLine = 150) {
                    for (const line of lines) {
                        // Check if terminal closed during print
                        if (overlay.classList.contains("hidden")) return;
                        log(line);
                        scrollToBottom();
                        await new Promise((r) => setTimeout(r, delayPerLine));
                    }
                }

                // --- Boot Sequence ---

                async function bootSequence() {
                    if (isBooted || !input) return;

                    const signal = abortController?.signal;
                    input.disabled = true;
                    input.style.opacity = "0";
                    startTime = Date.now();

                    const lines = [
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Initializing Guest Session...",
                            delay: 200,
                        },
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Connecting to janach.cloud...",
                            delay: 400,
                        },
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Requesting read-only access...",
                            delay: 300,
                        },
                        {
                            text: "Access granted. Welcome, visitor.",
                            delay: 200,
                        },
                        {
                            text: "Type 'help' to see available commands.",
                            delay: 0,
                        },
                    ];

                    for (const line of lines) {
                        if (
                            overlay.classList.contains("hidden") ||
                            signal?.aborted
                        )
                            return;
                        await new Promise((r) => setTimeout(r, line.delay));
                        log(line.text);
                    }

                    isBooted = true;
                    if (
                        !overlay.classList.contains("hidden") &&
                        !signal?.aborted
                    ) {
                        input.disabled = false;
                        input.style.opacity = "1";
                        focusInput();
                    }
                }

                // --- Execution ---

                function execute(cmdLine) {
                    const parts = cmdLine.split(" ");
                    const cmd = parts[0].toLowerCase();
                    const args = parts.slice(1);

                    switch (cmd) {
                        // --- Core Shell Commands ---
                        case "clear":
                            if (output) output.innerHTML = "";
                            break;

                        case "exit":
                            log("Terminating session...");
                            setTimeout(() => closeTerminal(), 500);
                            break;

                        case "sudo":
                            log("Root access isn't available in this terminal.");
                            break;

                        case "help":
