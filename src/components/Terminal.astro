---
import type { UptimeData } from "@lib/uptime";
import { experience, education, certifications, personalInfo, skills } from "@lib/cv-data";

interface Props {
    uptimeData: UptimeData;
}

const { uptimeData } = Astro.props;

// Prepare serializable data for the inline terminal script
const terminalData = {
    experience: experience.map(e => ({
        date: e.date,
        role: e.title,
        company: e.company.replace(/ d\.o\.o\.$/, ''),
    })),
    education: education.map(e => ({
        id: e.title,
        year: e.date,
        school: e.company,
        points: (e as any).terminalPoints || [],
    })),
    certifications: certifications.map(c => {
        const suffix = c.name.match(/\(([^)]+)\)$/);
        const prefix = c.name.match(/^([^:]+):\s*(.+)$/);
        const id = suffix?.[1] ?? prefix?.[1].trim() ?? "CERT";
        const name = suffix
            ? c.name.replace(/\s*\([^)]+\)$/, "")
            : prefix?.[2] ?? c.name;
        const doesNotExpire = c.expires === "No Expiration";

        return {
            id,
            name,
            link: c.link,
            date: c.issued,
            expiryLabel: doesNotExpire ? "Validity" : "Expires",
            expiry: doesNotExpire ? "Does not expire" : c.expires,
        };
    }),
    skills,
    personalInfo,
};
---

<div
    id="terminal-overlay"
    class="fixed inset-0 z-[9999] hidden items-center justify-center"
    style="isolation: isolate;"
    aria-hidden="true"
>
    <div
        id="terminal-window"
        class="terminal-window flex flex-col relative overflow-hidden"
        role="dialog"
        aria-modal="true"
        aria-label="Terminal Emulator"
    >
        <!-- Header -->
        <div id="terminal-titlebar" class="terminal-titlebar shrink-0">
            <div
                class="terminal-controls"
                role="group"
                aria-label="Window controls"
            >
                <button
                    type="button"
                    aria-label="Close terminal"
                    title="Close"
                    class="terminal-control terminal-control-close"
                    id="term-close-btn"
                >
                    <span
                        class="terminal-control-symbol terminal-control-symbol-close"
                        aria-hidden="true"
                    ></span>
                </button>
                <button
                    type="button"
                    aria-label="Minimize terminal"
                    title="Minimize"
                    class="terminal-control terminal-control-minimize"
                    id="term-minimize-btn"
                >
                    <span
                        class="terminal-control-symbol terminal-control-symbol-minimize"
                        aria-hidden="true"
                    ></span>
                </button>
                <button
                    type="button"
                    aria-label="Enter full screen"
                    aria-pressed="false"
                    title="Enter full screen"
                    class="terminal-control terminal-control-maximize"
                    id="term-maximize-btn"
                >
                    <span
                        class="terminal-control-symbol terminal-control-symbol-maximize"
                        aria-hidden="true"
                    ></span>
                </button>
            </div>
            <div
                class="terminal-title flex items-center justify-center select-none"
            >
                <div class="flex items-center gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="size-4 text-white/65"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                    <span class="font-semibold text-white/90">
                        janach.cloud
                    </span>
                </div>
            </div>
        </div>

        <!-- Universal Command Toolbar -->
        <div
            id="toolbar-container"
            class="toolbar-container shrink-0"
        >
            <button
                type="button"
                id="toolbar-toggle"
                class="toolbar-toggle"
                aria-expanded="true"
                aria-controls="cmd-toolbar"
            >
                <span class="toolbar-label">
                    <span class="toolbar-command-mark" aria-hidden="true">
                        <span class="toolbar-command-glyph">⌘</span>
                    </span>
                    <span>Quick Commands</span>
                </span>
                <svg
                    class="toggle-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m6 9 6 6 6-6"></path>
                </svg>
            </button>
            <div
                id="cmd-toolbar"
                class="cmd-toolbar no-scrollbar"
            >
                {
                    [
                        { cmd: "help", desc: "Show available commands" },
                        { cmd: "about", desc: "Who is Antonio?" },
                        { cmd: "experience", desc: "Work history" },
                        { cmd: "education", desc: "Academic background" },
                        { cmd: "certificates", desc: "Professional certs" },
                        { cmd: "skills", desc: "Tech stack" },
                        { cmd: "cv", desc: "Download full CV" },
                        { cmd: "contact", desc: "Get in touch" },
                        { cmd: "status", desc: "Service availability" },
                        { cmd: "neofetch", desc: "System info" },
                        { cmd: "clear", desc: "Clear terminal" },
                    ].map((item) => (
                        <button
                            type="button"
                            data-cmd={item.cmd}
                            title={`Run '${item.cmd}' - ${item.desc}`}
                            class="cmd-btn"
                        >
                            {item.cmd}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Terminal Content -->
        <div
            id="terminal-content"
            class="flex-1 overflow-y-auto cursor-text"
        >
            <div id="output"></div>
            <div class="terminal-input-line flex flex-wrap items-center mt-2">
                <span class="text-green-400 font-bold shrink-0 mr-2">➜</span>
                <span class="text-blue-400 shrink-0 mr-2"
                    >~ visitor@janach.cloud $</span
                >
                <input
                    type="text"
                    id="terminal-input"
                    class="bg-transparent border-none outline-none flex-1 text-white placeholder-white/50 min-w-[10px]"
                    spellcheck="false"
                    autocomplete="off"
                    aria-label="Terminal command"
                />
            </div>
        </div>

        <style>
            #terminal-overlay {
                padding:
                    max(1rem, env(safe-area-inset-top))
                    max(1rem, env(safe-area-inset-right))
                    max(1rem, env(safe-area-inset-bottom))
                    max(1rem, env(safe-area-inset-left));
                background: rgba(0, 0, 0, 0.42);
                opacity: 0;
                pointer-events: none;
                -webkit-backdrop-filter: blur(10px) saturate(125%);
                backdrop-filter: blur(10px) saturate(125%);
                transition: opacity 240ms ease;
            }

            #terminal-overlay.terminal-overlay-visible {
                opacity: 1;
                pointer-events: auto;
            }

            #terminal-window {
                --terminal-origin-x: 50%;
                --terminal-origin-y: 50%;
                width: min(48rem, calc(100vw - 2rem));
                height: min(37.5rem, calc(100vh - 2rem));
                height: min(37.5rem, calc(100dvh - 2rem));
                border: 1px solid rgba(255, 255, 255, 0.17);
                border-radius: 0.875rem;
                background:
                    linear-gradient(
                        180deg,
                        rgba(255, 255, 255, 0.085),
                        rgba(255, 255, 255, 0.018) 18%,
                        rgba(5, 5, 7, 0.08) 48%
                    ),
                    rgba(7, 7, 9, 0.8);
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.12),
                    inset 0 -1px 0 rgba(255, 255, 255, 0.035),
                    0 34px 90px rgba(0, 0, 0, 0.58),
                    0 8px 28px rgba(0, 0, 0, 0.38);
                opacity: 0;
                transform: translate3d(0, 8px, 0) scale(0.975);
                transform-origin: var(--terminal-origin-x)
                    var(--terminal-origin-y);
                -webkit-backdrop-filter: blur(34px) saturate(165%);
                backdrop-filter: blur(34px) saturate(165%);
                font-family:
                    ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
                    "Liberation Mono", monospace;
                font-size: 0.8125rem;
                line-height: 1.55;
                will-change: transform, opacity, width, height;
                backface-visibility: hidden;
                transition:
                    transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 180ms ease,
                    width 440ms cubic-bezier(0.2, 0.82, 0.2, 1),
                    height 440ms cubic-bezier(0.2, 0.82, 0.2, 1),
                    border-radius 440ms cubic-bezier(0.2, 0.82, 0.2, 1),
                    box-shadow 300ms ease;
            }

            #terminal-window::before {
                content: "";
                position: absolute;
                z-index: 20;
                inset: 0 0 auto;
                height: 1px;
                background: linear-gradient(
                    90deg,
                    transparent 2%,
                    rgba(255, 255, 255, 0.42) 26%,
                    rgba(255, 255, 255, 0.16) 68%,
                    transparent 98%
                );
                pointer-events: none;
            }

            #terminal-window.terminal-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0) scale(1);
            }

            #terminal-window.terminal-visible.terminal-settled {
                transform: none;
                will-change: auto;
                transition-property:
                    opacity, width, height, border-radius, box-shadow;
            }

            #terminal-window.terminal-closing {
                opacity: 0;
                transform: translate3d(0, 6px, 0) scale(0.975);
                transition-duration: 220ms;
            }

            #terminal-window.terminal-minimizing {
                animation: terminal-genie-out 460ms
                    cubic-bezier(0.48, 0, 0.72, 0.28) both;
            }

            @keyframes terminal-genie-out {
                0% {
                    border-radius: 0.875rem;
                    opacity: 1;
                    transform: translate3d(0, 0, 0) scale(1, 1);
                }
                38% {
                    border-radius: 1rem;
                    opacity: 1;
                    transform: translate3d(0, 0, 0) scale(0.94, 0.82);
                }
                72% {
                    border-radius: 1.5rem;
                    opacity: 0.94;
                    transform: translate3d(0, 0, 0) scale(0.42, 0.16);
                }
                100% {
                    border-radius: 2rem;
                    opacity: 0;
                    transform: translate3d(0, 0, 0) scale(0.08, 0.025);
                }
            }

            #terminal-window.terminal-maximized {
                width: calc(100vw - 2rem);
                height: calc(100vh - 2rem);
                height: calc(100dvh - 2rem);
                border-radius: 0.75rem;
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.13),
                    0 28px 100px rgba(0, 0, 0, 0.68);
            }

            .terminal-titlebar {
                position: relative;
                display: flex;
                min-height: 2.75rem;
                align-items: center;
                padding: 0 0.875rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.09);
                background: rgba(255, 255, 255, 0.055);
                box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.16);
            }

            .terminal-controls {
                position: relative;
                z-index: 2;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .terminal-control {
                position: relative;
                width: 0.75rem;
                height: 0.75rem;
                flex: 0 0 0.75rem;
                appearance: none;
                padding: 0;
                border: 0.5px solid rgba(0, 0, 0, 0.34);
                border-radius: 50%;
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.24),
                    0 0 0 0.5px rgba(255, 255, 255, 0.06);
                cursor: default;
                transition:
                    box-shadow 140ms ease,
                    opacity 140ms ease,
                    transform 140ms ease;
            }

            .terminal-control-symbol {
                position: absolute;
                inset: 0;
                opacity: 0;
                pointer-events: none;
                transition: opacity 120ms ease;
            }

            .terminal-control-symbol-close::before,
            .terminal-control-symbol-close::after,
            .terminal-control-symbol-minimize::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0.375rem;
                height: 1px;
                border-radius: 1px;
                background: rgba(0, 0, 0, 0.62);
                transform-origin: center;
            }

            .terminal-control-symbol-close::before {
                transform: translate(-50%, -50%) rotate(45deg);
            }

            .terminal-control-symbol-close::after {
                transform: translate(-50%, -50%) rotate(-45deg);
            }

            .terminal-control-symbol-minimize::before {
                transform: translate(-50%, -50%);
            }

            .terminal-titlebar:hover .terminal-control-symbol,
            .terminal-control:focus-visible .terminal-control-symbol {
                opacity: 1;
            }

            .terminal-control:hover {
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.34),
                    0 0 0 0.5px rgba(255, 255, 255, 0.14);
            }

            .terminal-control:active,
            .terminal-control.control-activated {
                transform: scale(0.82);
                opacity: 0.78;
            }

            .terminal-control:focus-visible,
            .cmd-btn:focus-visible,
            .toolbar-toggle:focus-visible {
                outline: 2px solid rgba(10, 132, 255, 0.95);
                outline-offset: 2px;
            }

            .terminal-control-close {
                background: #ff5f57;
            }

            .terminal-control-minimize {
                background: #febc2e;
            }

            .terminal-control-maximize {
                background: #28c840;
            }

            .terminal-control-symbol-maximize {
                width: 0.3125rem;
                height: 0.3125rem;
                margin: auto;
                border: 1px solid rgba(0, 0, 0, 0.58);
                border-radius: 1px;
            }

            .terminal-title {
                position: absolute;
                inset: 0;
                padding: 0 5rem;
                pointer-events: none;
                color: rgba(255, 255, 255, 0.88);
                font-family: "Atkinson", sans-serif;
                font-size: 0.75rem;
                letter-spacing: 0;
            }

            .toolbar-container {
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                background: #0d0d0f;
            }

            .toolbar-toggle {
                display: flex;
                width: 100%;
                min-height: 1.875rem;
                align-items: center;
                justify-content: space-between;
                padding: 0 0.875rem;
                border: 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.045);
                background: transparent;
                color: rgba(255, 255, 255, 0.68);
                font-family: "Atkinson", sans-serif;
                font-size: 0.8125rem;
                font-weight: 700;
                letter-spacing: 0;
                cursor: pointer;
                transition:
                    background-color 160ms ease,
                    color 160ms ease;
            }

            .toolbar-toggle:hover {
                background: rgba(255, 255, 255, 0.05);
                color: rgba(255, 255, 255, 0.82);
            }

            .toolbar-label {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .toolbar-command-mark {
                display: inline-flex;
                width: 1rem;
                height: 1rem;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 0.25rem;
                background: rgba(255, 255, 255, 0.055);
                color: rgba(255, 255, 255, 0.72);
                font-family: ui-sans-serif, system-ui, sans-serif;
                font-size: 0.6875rem;
                line-height: 1;
            }

            .toolbar-command-glyph {
                display: block;
            }

            .toggle-icon {
                width: 0.875rem;
                height: 0.875rem;
                transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
            }

            .cmd-toolbar {
                display: flex;
                max-height: 3rem;
                align-items: center;
                gap: 0.375rem;
                overflow-x: auto;
                padding: 0.4375rem 0.625rem;
                background: transparent;
                transition:
                    max-height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
                    padding 220ms ease;
            }

            .cmd-btn {
                height: 1.75rem;
                flex: 0 0 auto;
                padding: 0 0.5625rem;
                border: 1px solid rgba(255, 255, 255, 0.11);
                border-radius: 0.375rem;
                background: rgba(255, 255, 255, 0.055);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
                color: rgba(255, 255, 255, 0.86);
                font: inherit;
                font-size: 0.8125rem;
                font-weight: 700;
                line-height: 1;
                white-space: nowrap;
                cursor: pointer;
                transition:
                    background-color 140ms ease,
                    border-color 140ms ease,
                    color 140ms ease;
            }

            .cmd-btn:hover {
                border-color: rgba(255, 255, 255, 0.2);
                background: rgba(255, 255, 255, 0.11);
                color: #fff;
            }

            .cmd-btn:active {
                background: rgba(255, 255, 255, 0.075);
            }

            .toolbar-collapsed .cmd-toolbar {
                max-height: 0;
                padding-top: 0;
                padding-bottom: 0;
                pointer-events: none;
            }

            .toolbar-collapsed .toggle-icon {
                transform: rotate(-90deg);
            }

            #terminal-content {
                padding: 1rem;
                color: rgba(255, 255, 255, 0.88);
                background: rgba(0, 0, 0, 0.28);
                caret-color: #f5f5f7;
                scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
                scrollbar-width: thin;
            }

            #terminal-content ::selection {
                background: rgba(10, 132, 255, 0.42);
                color: #fff;
            }

            #terminal-input {
                padding: 0;
                font: inherit;
                line-height: inherit;
                caret-color: #f5f5f7;
            }

            .terminal-input-line {
                min-height: 1.5rem;
            }

            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            #terminal-content::-webkit-scrollbar {
                width: 6px;
            }

            #terminal-content::-webkit-scrollbar-track {
                background: transparent;
            }

            #terminal-content::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 3px;
            }

            #terminal-content::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.2);
            }

            @media (max-width: 639px) {
                #terminal-overlay {
                    padding:
                        max(0.5rem, env(safe-area-inset-top))
                        max(0.5rem, env(safe-area-inset-right))
                        max(0.5rem, env(safe-area-inset-bottom))
                        max(0.5rem, env(safe-area-inset-left));
                }

                #terminal-window {
                    width: calc(100vw - 1rem);
                    height: min(37.5rem, calc(100vh - 1rem));
                    height: min(37.5rem, calc(100dvh - 1rem));
                    border-radius: 0.75rem;
                    font-size: 0.8125rem;
                    line-height: 1.6;
                }

                #terminal-window.terminal-maximized {
                    width: calc(100vw - 1rem);
                    height: calc(100vh - 1rem);
                    height: calc(100dvh - 1rem);
                    border-radius: 0.75rem;
                }

                .terminal-titlebar {
                    min-height: 2.625rem;
                    padding: 0 0.75rem;
                }

                .terminal-title {
                    padding: 0 4.5rem;
                }

                #terminal-content {
                    padding: 0.75rem;
                }

                :global(#output > div) {
                    min-width: 0;
                    margin-bottom: 0.375rem;
                    overflow-wrap: anywhere;
                }

                .terminal-input-line {
                    line-height: 1.5;
                }

                :global(.terminal-command-prompt) {
                    white-space: nowrap;
                }

                @media (max-width: 380px) {
                    :global(.terminal-command-echo) {
                        display: grid;
                        gap: 0.125rem;
                    }

                    :global(.terminal-command-value) {
                        padding-left: 1.25rem;
                        color: rgba(255, 255, 255, 0.9);
                    }
                }

                .cmd-toolbar {
                    padding-right: 0.5rem;
                    padding-left: 0.5rem;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                #terminal-overlay,
                #terminal-window,
                .terminal-control,
                .toolbar-toggle,
                .toggle-icon,
                .cmd-toolbar,
                .cmd-btn {
                    transition-duration: 1ms !important;
                    transition-delay: 0ms !important;
                }

                #terminal-window.terminal-minimizing,
                #terminal-window.terminal-closing {
                    transform: scale(0.98);
                    animation: none;
                }
            }
        </style>

        <style is:global>
            html.terminal-open {
                overflow: hidden !important;
            }
            body.terminal-scroll-locked {
                position: fixed !important;
                top: var(--terminal-page-offset) !important;
                right: 0;
                left: 0;
                width: 100%;
            }
            html.terminal-open body * {
                pointer-events: none !important;
            }
            html.terminal-open #terminal-overlay,
            html.terminal-open #terminal-window,
            html.terminal-open #terminal-window * {
                pointer-events: auto !important;
            }
        </style>


        <script define:vars={{ uptimeData, terminalData }}>
            let isBooted = false;
            let isAnimating = false;
            let isMaximized = false;
            let history = [];
            let historyIndex = -1;
            let lastTrigger = null;
            let pageScrollY = 0;

            let activeTimeouts = [];
            let abortController = null;

            // Build terminal HTML content from injected cv-data
            const EXPERIENCE_CONTENT = terminalData.experience.map(
                (e) => `
                <div class="group mt-2 grid gap-2 rounded-lg border border-white/10 bg-white/[0.025] px-3 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-colors hover:bg-white/[0.045] sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center sm:gap-4 sm:px-4">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-yellow-300">
                        <span class="size-1.5 shrink-0 rounded-full bg-white/45"></span>
                        <span>${e.date}</span>
                    </div>
                    <div class="min-w-0">
                        <div class="text-white/90 font-semibold text-[13px] sm:text-sm leading-snug break-words">${e.role}</div>
                        <div class="mt-0.5 text-[10px] sm:text-[11px] text-white/70 font-semibold uppercase break-words">${e.company}</div>
                    </div>
                </div>
            `,
            );

            const EDUCATION_CONTENT = terminalData.education.map(
                (e) => `
        <div class="mt-2 rounded-lg border border-white/10 bg-white/[0.025] p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-colors hover:bg-white/[0.04] sm:p-4">
            <div class="flex flex-col gap-2 border-b border-white/[0.07] pb-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                    <div class="text-[10px] font-bold uppercase text-yellow-300">${e.id}</div>
                    <div class="mt-1 text-white/90 font-semibold text-[13px] sm:text-sm text-balance leading-snug">${e.school}</div>
                </div>
                <div class="shrink-0 text-[10px] font-semibold uppercase text-white/70 sm:text-right">
                    ${e.year}
                </div>
            </div>
            <div class="mt-3 flex flex-col divide-y divide-white/[0.06] text-left">
                    ${e.points
                        .map(
                            (p) => `
                        <div class="grid grid-cols-[auto_minmax(0,1fr)] sm:grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-2.5 gap-y-2 py-3 first:pt-0 last:pb-0 text-white/80 text-[12px] sm:text-[13px] leading-relaxed group/point">
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-white/35"></span>
                            <div class="min-w-0">
                                <span class="font-semibold text-white/90 not-italic">${p.label}:</span>
                                <span class="text-white/75">${p.text}</span>
                            </div>
