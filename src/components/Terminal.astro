    <div class="font-bold text-green-400">System:</div><div>All systems normal</div>
    <div class="font-bold text-green-400">SessionID:</div><div>${Math.random().toString(36).substr(2, 9)}</div>
    <div class="font-bold text-green-400">Uptime:</div><div>${uptime}s</div>
    <div class="font-bold text-green-400">Time:</div><div>${new Date().toLocaleTimeString()}</div>
  </div>
</div>`);
                        break;

                    case "neofetch":
                        log(`
