                                return FILES[f] === "dir"
                                    ? `<span class="text-blue-400 font-bold">${f}/</span>`
                                    : f;
                            });
                            log(fileNames.join("&nbsp;&nbsp;"));
                            break;

                        case "cat":
                            const file = args[0];
                            if (!file) {
                                log("Usage: cat [filename]");
                                break;
                            }

                            // Special handlers for rich content files
                            if (file === "contact.sh") {
                                execute("contact");
                                break;
                            }
                            if (file === "about.txt") {
                                execute("about");
                                break;
