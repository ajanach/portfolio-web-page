<div
    id="terminal-overlay"
    class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4 opacity-0 transition-opacity duration-300 pointer-events-none"
    style="isolation: isolate;"
>
    <div
        id="terminal-window"
        class="bg-[#050505] rounded-lg shadow-2xl overflow-hidden border border-white/10 flex flex-col font-mono text-xs sm:text-sm md:text-base relative transition-all duration-300 transform will-change-transform backface-hidden scale-95 opacity-0"
        style="width: 95%; max-width: 48rem; height: 80vh; max-height: 600px; transform: translateZ(0);"
        role="dialog"
        aria-modal="true"
        aria-label="Terminal Emulator"
    >
        <!-- Header -->
        <div
            class="h-8 bg-[#1a1a1a] flex items-center px-4 justify-between border-b border-white/5 shrink-0"
        >
            <div class="flex gap-2">
                <div
                    class="w-3 h-3 rounded-full bg-[#ff5f56] hover:bg-[#ff5f56]/80 cursor-pointer"
                    id="term-close-btn"
                >
                </div>
                <div
                    class="w-3 h-3 rounded-full bg-[#ffbd2e] hover:bg-[#ffbd2e]/80 cursor-pointer"
                    id="term-minimize-btn"
                >
                </div>
                <div
                    class="w-3 h-3 rounded-full bg-green-400 hover:bg-green-400/80 cursor-pointer"
                    id="term-maximize-btn"
                >
                </div>
            </div>
            <div
                class="flex items-center justify-center w-full px-4 select-none"
            >
                <div class="flex items-center gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 text-white/80"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                    <span
                        class="text-[14px] font-semibold text-white/100 tracking-tight"
                    >
                        janach.cloud
                    </span>
                </div>
            </div>
        </div>

        <!-- Terminal Content -->
        <div
            id="terminal-content"
            class="flex-1 p-4 overflow-y-auto text-white/90 selection:bg-white/20 cursor-text"
            style="text-shadow: 0 0 5px rgba(255, 255, 255, 0.2);"
        >
            <div id="output"></div>
            <div class="flex flex-wrap items-center mt-2">
                <span class="text-green-400 font-bold shrink-0 mr-2">➜</span>
                <span class="text-blue-400 shrink-0 mr-2"
                    >~ visitor@janach.cloud $</span
                >
                <input
                    type="text"
                    id="terminal-input"
                    class="bg-transparent border-none outline-none flex-1 text-white placeholder-white/50 min-w-[10px]"
                    spellcheck="false"
                />
            </div>
        </div>
    </div>

    <style>
        /* Scrollbar Styling */
        #terminal-content::-webkit-scrollbar {
            width: 6px;
        }
        #terminal-content::-webkit-scrollbar-track {
            background: transparent;
        }
        #terminal-content::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }
        #terminal-content::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Scanline effect (optional, subtle) */
        #terminal-window::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%,
                rgba(0, 0, 0, 0.1) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
            opacity: 0.15;
            z-index: 10;
        }
        .will-change-transform {
            will-change: transform, opacity;
        }
        .backface-hidden {
            backface-visibility: hidden;
        }

        #terminal-window {
            transition:
                transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease,
                width 0.3s ease,
                height 0.3s ease;
        }

        /* Klasa koju ćemo toggle-ati */
        .terminal-maximized {
            width: 95vw !important; /* Širina na 95% ekrana */
            height: 90vh !important; /* Visina na 90% ekrana */
            max-width: none !important; /* Mičemo limit od 48rem */
            max-height: none !important; /* Mičemo limit visine */
            transform: scale(
                1
            ) !important; /* Vraćamo na originalni scale da ne muti tekst */
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }
    </style>

    <style is:global>
        /* NUCLEAR OPTION: Global Event Silencing */
        body.terminal-open * {
            pointer-events: none !important;
        }
        /* Whitelist Terminal */
        body.terminal-open #terminal-overlay,
        body.terminal-open #terminal-window,
        body.terminal-open #terminal-window * {
            pointer-events: auto !important;
        }
    </style>

