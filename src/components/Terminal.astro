---
import type { UptimeData } from "@lib/uptime";
import { experience, education, certifications, personalInfo, skills } from "@lib/cv-data";

interface Props {
    uptimeData: UptimeData;
}

const { uptimeData } = Astro.props;

// Prepare serializable data for the inline terminal script
const terminalData = {
    experience: experience.map(e => ({
        date: e.date,
        role: e.title,
        company: e.company.replace(/ d\.o\.o\.$/, ''),
    })),
    education: education.map(e => ({
        id: e.title,
        year: e.date,
        school: e.company,
        points: (e as any).terminalPoints || [],
    })),
    certifications: certifications.map(c => {
        const match = c.name.match(/\(([^)]+)\)$/);
        const id = match ? match[1] : c.name.split(':')[0].trim();
        return { id, name: c.name, link: c.link, date: c.issued, exp: c.expires };
    }),
    skills,
    personalInfo,
};
---

<div
    id="terminal-overlay"
    class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4 opacity-0 transition-opacity duration-300 pointer-events-none"
    style="isolation: isolate;"
>
    <div
        id="terminal-window"
        class="bg-[#050505] rounded-lg shadow-2xl overflow-hidden border border-white/10 flex flex-col font-mono text-xs sm:text-sm md:text-base relative transition-all duration-300 transform will-change-transform backface-hidden scale-95 opacity-0"
        style="width: 95%; max-width: 48rem; height: 80vh; max-height: 600px; transform: translateZ(0);"
        role="dialog"
        aria-modal="true"
        aria-label="Terminal Emulator"
    >
        <!-- Header -->
        <div
            class="h-8 bg-[#1a1a1a] flex items-center px-4 justify-between border-b border-white/5 shrink-0"
        >
            <div class="flex gap-2">
                <div
                    class="w-3 h-3 rounded-full bg-[#ff5f56] hover:bg-[#ff5f56]/80 cursor-pointer"
                    id="term-close-btn"
                >
                </div>
                <div
                    class="w-3 h-3 rounded-full bg-[#ffbd2e] hover:bg-[#ffbd2e]/80 cursor-pointer"
                    id="term-minimize-btn"
                >
                </div>
                <div
                    class="w-3 h-3 rounded-full bg-green-400 hover:bg-green-400/80 cursor-pointer"
                    id="term-maximize-btn"
                >
                </div>
            </div>
            <div
                class="flex items-center justify-center w-full px-4 select-none"
            >
                <div class="flex items-center gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 text-white/80"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                    <span
                        class="text-[14px] font-semibold text-white/100 tracking-tight"
                    >
                        janach.cloud
                    </span>
                </div>
            </div>
        </div>

        <!-- Universal Command Toolbar -->
        <div
            id="toolbar-container"
            class="toolbar-container border-b border-white/10 shrink-0"
        >
            <button
                id="toolbar-toggle"
                class="toolbar-toggle w-full px-4 py-1.5 flex items-center justify-between bg-white/[0.02] hover:bg-white/[0.05] text-white/60 hover:text-white/80 text-xs transition-colors cursor-pointer border-none"
                aria-expanded="true"
                aria-controls="cmd-toolbar"
            >
                <span class="flex items-center gap-2">
                    <span>💡</span>
                    <span>Quick Commands</span>
                </span>
                <span class="toggle-icon transition-transform">▼</span>
            </button>
            <div
                id="cmd-toolbar"
                class="cmd-toolbar flex items-center gap-2 px-4 py-2 bg-white/5 overflow-x-auto no-scrollbar"
            >
                {
                    [
                        { cmd: "help", desc: "Show available commands" },
                        { cmd: "about", desc: "Who is Antonio?" },
                        { cmd: "experience", desc: "Work history" },
                        { cmd: "education", desc: "Academic background" },
                        { cmd: "certificates", desc: "Professional certs" },
                        { cmd: "skills", desc: "Tech stack" },
                        { cmd: "cv", desc: "Download full CV" },
                        { cmd: "contact", desc: "Get in touch" },
                        { cmd: "neofetch", desc: "System info" },
                        { cmd: "clear", desc: "Clear terminal" },
                    ].map((item) => (
                        <button
                            data-cmd={item.cmd}
                            title={`Run '${item.cmd}' - ${item.desc}`}
                            class="cmd-btn px-3 py-1.5 bg-white/10 hover:bg-white/20 border border-white/10 rounded text-xs text-white font-mono whitespace-nowrap active:scale-95 transition-all"
                        >
                            {item.cmd}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Terminal Content -->
        <div
            id="terminal-content"
            class="flex-1 p-4 overflow-y-auto text-white/90 selection:bg-white/20 cursor-text"
            style="text-shadow: 0 0 5px rgba(255, 255, 255, 0.2);"
        >
            <div id="output"></div>
            <div class="flex flex-wrap items-center mt-2">
                <span class="text-green-400 font-bold shrink-0 mr-2">➜</span>
                <span class="text-blue-400 shrink-0 mr-2"
                    >~ visitor@janach.cloud $</span
                >
                <input
                    type="text"
                    id="terminal-input"
                    class="bg-transparent border-none outline-none flex-1 text-white placeholder-white/50 min-w-[10px]"
                    spellcheck="false"
                />
            </div>
        </div>

        <style>
            /* Mobile Toolbar Scrollbar */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }
            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            /* Scrollbar Styling */
            #terminal-content::-webkit-scrollbar {
                width: 6px;
            }
            #terminal-content::-webkit-scrollbar-track {
                background: transparent;
            }
            #terminal-content::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 3px;
            }
            #terminal-content::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.2);
            }

            /* Scanline effect (optional, subtle) */
            #terminal-window::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(
                    rgba(18, 16, 16, 0) 50%,
                    rgba(0, 0, 0, 0.1) 50%
                );
                background-size: 100% 4px;
                pointer-events: none;
                opacity: 0.15;
                z-index: 10;
            }
            .will-change-transform {
                will-change: transform, opacity;
            }
            .backface-hidden {
                backface-visibility: hidden;
            }

            #terminal-window {
                transition:
                    transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                    scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                    translate 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                    opacity 0.3s ease,
                    width 0.3s ease,
                    height 0.3s ease;
                will-change: transform, scale, translate, opacity, width, height;
                backface-visibility: hidden;
            }

            .terminal-maximized {
                width: 95vw !important;
                height: 90vh !important;
                max-width: none !important;
                max-height: none !important;
                transform: scale(1) translateY(0) !important;
                transition:
                    transform 0.3s cubic-bezier(0.23, 1, 0.32, 1),
                    width 0.3s cubic-bezier(0.23, 1, 0.32, 1),
                    height 0.3s cubic-bezier(0.23, 1, 0.32, 1),
                    box-shadow 0.3s ease !important;
                box-shadow: 0 40px 100px rgba(0, 0, 0, 0.8) !important;
                border-color: rgba(255, 255, 255, 0.2) !important;
                z-index: 50;
            }

            .terminal-normalizing {
                transition:
                    transform 0.32s cubic-bezier(0.4, 0, 0.2, 1),
                    width 0.32s cubic-bezier(0.4, 0, 0.2, 1),
                    height 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
            }

            /* Pulse Animation for Close Button */
            @keyframes term-btn-pulse {
                0% {
                    transform: scale(1);
                }
                50% {
                    transform: scale(1.4);
                }
                100% {
                    transform: scale(1);
                }
            }

            .btn-pulse {
                animation: term-btn-pulse 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* Smooth Exit State */
            .terminal-exiting {
                transform: scale(0.95) translateY(10px) !important;
                opacity: 0 !important;
            }

            /* Universal Command Toolbar */
            .toolbar-collapsed .cmd-toolbar {
                max-height: 0;
                opacity: 0;
                padding-top: 0;
                padding-bottom: 0;
                overflow: hidden;
            }
            .toolbar-collapsed .toggle-icon {
                transform: rotate(-90deg);
            }
            .cmd-toolbar {
                max-height: 48px;
                opacity: 1;
                transition:
                    max-height 0.3s ease,
                    opacity 0.2s ease,
                    padding 0.2s ease;
            }
            @media (min-width: 768px) {
                .cmd-btn {
                    opacity: 0.7;
                    padding: 0.25rem 0.75rem;
                    font-size: 0.7rem;
                }
                .cmd-btn:hover {
                    opacity: 1;
                }
            }
        </style>

        <style is:global>
            /* FIX: Use CSS class for body overflow instead of inline style mutation */
            body.terminal-open {
                overflow: hidden !important;
            }
            body.terminal-open * {
                pointer-events: none !important;
            }
            body.terminal-open #terminal-overlay,
            body.terminal-open #terminal-window,
            body.terminal-open #terminal-window * {
                pointer-events: auto !important;
            }
        </style>


        <script define:vars={{ uptimeData, terminalData }}>
            let isBooted = false;
            let isAnimating = false;
            let isMaximized = false;
            let history = [];
            let historyIndex = -1;

            let activeTimeouts = [];
            let abortController = null;

            // Build terminal HTML content from injected cv-data
            const EXPERIENCE_CONTENT = [
                `<div class="grid gap-3 max-w-4xl mt-3">`,
                ...terminalData.experience.map(
                    (e) => `
                <div class="flex flex-col gap-0.5 p-3 bg-white/[0.03] border-l-2 border-yellow-300/80 rounded-r transition-colors hover:bg-white/[0.06]">
                    <div class="flex items-center gap-2">
                         <span class="text-yellow-300 font-bold text-xs tracking-tight uppercase">${e.date}</span>
                         <span class="text-white/30 text-xs">•</span>
                         <span class="text-white font-bold text-sm tracking-tight">${e.role}</span>
                    </div>
                    <div class="text-[12px] text-white/50 font-medium uppercase tracking-wider ml-0.5">@ ${e.company}</div>
                </div>
            `,
                ),
                `</div>`,
            ];

            const EDUCATION_CONTENT = [
                `<div class="grid gap-3 max-w-4xl mt-3">`,
                ...terminalData.education.map(
                    (e) => `
        <div class="flex flex-col gap-3 p-3 bg-white/[0.03] border-l-2 border-yellow-300/80 rounded-r transition-colors hover:bg-white/[0.06]">
            <div class="flex flex-col gap-1 text-left">
                <div class="flex flex-col sm:flex-row sm:items-center gap-x-2">
                    <span class="text-yellow-300 font-bold text-sm tracking-tight uppercase">${e.id}</span>
                    <span class="hidden sm:inline text-white/30">•</span>
                    <span class="text-white font-bold text-sm text-balance leading-tight">${e.school}</span>
                </div>
                <div class="text-[11px] font-bold text-white uppercase tracking-[0.2em] mb-1">
                    ${e.year}
                </div>
                <div class="flex flex-col gap-3 text-left">
                    ${e.points
                        .map(
                            (p) => `
                        <div class="flex items-start gap-3 text-white/90 text-[13px] leading-relaxed group/point">
                            <span class="text-yellow-300/80 text-[8px] mt-1.5 flex-shrink-0">◆</span>
                            <div class="flex-1">
                                <span class="font-bold text-white not-italic opacity-100">${p.label}:</span> 
                                <span class="italic text-white/80">${p.text}</span>
                            </div>
                            <a href="${p.link}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-1.5 bg-green-400/10 hover:bg-green-400 border border-green-400/30 text-green-400 hover:text-black text-xs font-black rounded transition-all no-underline shrink-0 active:scale-95">
                                VIEW ↗
                            </a>
                        </div>
                    `,
                        )
                        .join("")}
                </div>
            </div>
        </div>
    `,
                ),
                `</div>`,
            ];

            const CERTS_CONTENT = [
                `<div class="grid gap-3 max-w-4xl mt-3">`,
                ...terminalData.certifications.map(
                    (c) => `
        <div class="flex items-center justify-between p-3 bg-white/[0.03] border-l-2 border-yellow-300/80 rounded-r transition-colors hover:bg-white/[0.06]">
            <div class="flex flex-col gap-0.5">
                <div class="flex items-center gap-2">
                    <span class="text-yellow-300/90 font-bold text-xs tracking-tight">[${c.id}]</span>
                    <span class="text-white/80 font-semibold text-sm">${c.name}</span>
                </div>
                <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-white/100 uppercase text-xs tracking-wider font-medium">Issued: ${c.date}</span>
                    <span class="text-green-400 uppercase text-xs tracking-widest font-bold">Expires: ${c.exp}</span>
                </div>
            </div>
            <a href="${c.link}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-1.5 bg-green-400/10 hover:bg-green-400 border border-green-400/30 text-green-400 hover:text-black text-xs font-black rounded transition-all no-underline shrink-0 active:scale-95">
                VERIFY ↗
            </a>
        </div>
    `,
                ),
                `</div>`,
            ];

            const FILES = {
                "about.txt": "content",
                "contact.sh": "content",
            };

            const COMMANDS = {
                help: "Show available commands",
                about: "Who is Antonio?",
                experience: "Work history",
                education: "Academic background",
                certificates: "Professional certs",
                skills: "Tech stack",
                cv: "Download full CV",
                contact: "Get in touch",
                ls: "List files",
                cat: "Read file",
                whoami: "Current session info",
                status: "System uptime",
                neofetch: "System info",
                clear: "Clear terminal",
                exit: "Close terminal",
                sudo: "Execute as root",
            };

            function initTerminal() {
                const overlay = document.getElementById("terminal-overlay");
                const windowEl = document.getElementById("terminal-window");
                const content = document.getElementById("terminal-content");
                const output = document.getElementById("output");
                const input = document.getElementById("terminal-input");

                // Buttons
                const closeBtn = document.getElementById("term-close-btn");
                const minimizeBtn =
                    document.getElementById("term-minimize-btn");
                const maximizeBtn =
                    document.getElementById("term-maximize-btn");

                // Toolbar
                const toolbarToggle = document.getElementById("toolbar-toggle");
                const toolbarContainer =
                    document.getElementById("toolbar-container");

                // Initialize Toggle State
                const isCollapsed =
                    localStorage.getItem("terminal_toolbar_visible") ===
                    "false";
                if (isCollapsed)
                    toolbarContainer?.classList.add("toolbar-collapsed");
                toolbarToggle?.setAttribute(
                    "aria-expanded",
                    String(!isCollapsed),
                );

                if (!overlay || !windowEl || !input) return;

                // --- Core Actions ---

                function trackedTimeout(callback, delay) {
                    const id = window.setTimeout(() => {
                        if (overlay.classList.contains("hidden")) return;
                        callback();
                    }, delay);
                    activeTimeouts.push(id);
                    return id;
                }

                function clearTimeouts() {
                    activeTimeouts.forEach((id) => window.clearTimeout(id));
                    activeTimeouts = [];
                }

                function openTerminal() {
                    if (isAnimating) return;
                    isAnimating = true;

                    abortController?.abort();
                    abortController = new AbortController();

                    document.body.classList.add("terminal-open");
                    overlay.classList.remove("hidden");
                    overlay.classList.add("flex");

                    requestAnimationFrame(() => {
                        overlay.style.pointerEvents = "all";
                        overlay.classList.remove("opacity-0");

                        windowEl.classList.remove(
                            "scale-95",
                            "opacity-0",
                            "translate-y-10",
                        );
                        windowEl.classList.add("opacity-100", "scale-100");

                        trackedTimeout(() => {
                            isAnimating = false;
                            if (!isBooted) bootSequence();
                            else focusInput();
                        }, 300);
                    });
                }

                function closeTerminal() {
                    if (isAnimating) return;
                    isAnimating = true;

                    clearTimeouts();
                    abortController?.abort();

                    // Pulse effect on close button
                    const closeBtn = document.getElementById("term-close-btn");
                    if (closeBtn) {
                        closeBtn.classList.add("btn-pulse");
                    }

                    requestAnimationFrame(() => {
                        overlay.classList.add("opacity-0");
                        overlay.style.pointerEvents = "none";

                        if (isMaximized) {
                            // Smooth scale 1.2 -> 1 exit
                            windowEl.classList.add("terminal-exiting");
                        } else {
                            // Standard Close Animation
                            windowEl.classList.remove(
                                "scale-100",
                                "opacity-100",
                            );
                            windowEl.classList.add("scale-95", "opacity-0");
                        }

                        input.blur();

                        window.setTimeout(() => {
                            overlay.classList.add("hidden");
                            overlay.classList.remove("flex");
                            if (isMaximized) {
                                toggleMaximize(true);
                                windowEl.classList.remove("terminal-exiting");
                            }
                            document.body.classList.remove("terminal-open");
                            if (input) input.value = "";
                            if (closeBtn)
                                closeBtn.classList.remove("btn-pulse");
                            isAnimating = false;
                        }, 300);
                    });
                }

                function minimizeTerminal() {
                    if (isAnimating) return;
                    isAnimating = true;

                    clearTimeouts();
                    abortController?.abort();

                    overlay.classList.add("opacity-0");
                    overlay.style.pointerEvents = "none";

                    windowEl.classList.remove("terminal-maximized");
                    windowEl.classList.remove("scale-100", "opacity-100");
                    windowEl.classList.add("translate-y-10", "opacity-0");

                    input.blur();

                    window.setTimeout(() => {
                        overlay.classList.add("hidden");
                        overlay.classList.remove("flex");
                        document.body.classList.remove("terminal-open");
                        windowEl.classList.remove("translate-y-10");
                        isMaximized = false;
                        if (input) input.value = "";
                        isAnimating = false;
                    }, 300);
                }

                function toggleMaximize(forceReset = false) {
                    if (forceReset) {
                        windowEl.classList.remove("terminal-maximized");
                        isMaximized = false;
                        return;
                    }

                    if (isMaximized) {
                        // CRITICAL: Remove maximized class IMMEDIATELY so the window can shrink
                        windowEl.classList.remove("terminal-maximized");
                        windowEl.classList.add("terminal-normalizing");
                        setTimeout(() => {
                            windowEl.classList.remove("terminal-normalizing");
                        }, 320);
                    } else {
                        windowEl.classList.add("terminal-maximized");
                    }
                    isMaximized = !isMaximized;

                    setTimeout(() => focusInput(), 50);
                }

                function focusInput() {
                    if (
                        document.activeElement !== input &&
                        !overlay.classList.contains("hidden")
                    ) {
                        input.focus({ preventScroll: true });
                    }
                }

                // --- Helpers ---

                function scrollToBottom() {
                    if (content) {
                        requestAnimationFrame(() => {
                            content.scrollTop = content.scrollHeight;
                        });
                    }
                }

                async function printLines(lines, delayPerLine = 150) {
                    for (const line of lines) {
                        // Check if terminal closed during print
                        if (overlay.classList.contains("hidden")) return;
                        log(line);
                        scrollToBottom();
                        await new Promise((r) => setTimeout(r, delayPerLine));
                    }
                }

                // --- Boot Sequence ---

                async function bootSequence() {
                    if (isBooted || !input) return;

                    const signal = abortController?.signal;
                    input.disabled = true;
                    input.style.opacity = "0";
                    startTime = Date.now();

                    const lines = [
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Initializing Guest Session...",
                            delay: 200,
                        },
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Connecting to janach.cloud...",
                            delay: 400,
                        },
                        {
                            text: "[ <span class='text-green-400'>OK</span> ] Requesting read-only access...",
                            delay: 300,
                        },
                        {
                            text: "Access granted. Welcome, visitor.",
                            delay: 200,
                        },
                        {
                            text: "Type 'help' to see available commands.",
                            delay: 0,
                        },
                    ];

                    for (const line of lines) {
                        if (
                            overlay.classList.contains("hidden") ||
                            signal?.aborted
                        )
                            return;
                        await new Promise((r) => setTimeout(r, line.delay));
                        log(line.text);
                    }

                    isBooted = true;
                    if (
                        !overlay.classList.contains("hidden") &&
                        !signal?.aborted
                    ) {
                        input.disabled = false;
                        input.style.opacity = "1";
                        focusInput();
                    }
                }

                // --- Execution ---

                function execute(cmdLine) {
                    const parts = cmdLine.split(" ");
                    const cmd = parts[0].toLowerCase();
                    const args = parts.slice(1);

                    switch (cmd) {
                        // --- Core Shell Commands ---
                        case "clear":
                            if (output) output.innerHTML = "";
                            break;

                        case "exit":
                            log("Terminating session...");
                            setTimeout(() => closeTerminal(), 500);
                            break;

                        case "sudo":
                            log("Nice try, but no root for you.");
                            break;

                        case "help":
                            let helpHTML =
                                "<div class='grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-4 gap-y-2 sm:gap-y-1 opacity-90'>";
                            for (const [key, desc] of Object.entries(
                                COMMANDS,
                            )) {
                                helpHTML += `<div class='flex flex-row sm:contents'><div class='text-yellow-300 font-bold min-w-[100px]'>${key}</div><div class='text-white/80'>${desc}</div></div>`;
                            }
                            helpHTML += "</div>";
                            log(helpHTML);
                            break;

                        case "ls":
                            const fileNames = Object.keys(FILES).map((f) => {
                                return FILES[f] === "dir"
                                    ? `<span class="text-blue-400 font-bold">${f}/</span>`
                                    : f;
                            });
                            log(fileNames.join("&nbsp;&nbsp;"));
                            break;

                        case "cat":
                            const file = args[0];
                            if (!file) {
                                log("Usage: cat [filename]");
                                break;
                            }

                            // Special handlers for rich content files
                            if (file === "contact.sh") {
                                execute("contact");
                                break;
                            }
                            if (file === "about.txt") {
                                execute("about");
                                break;
                            }

                            // Standard file handling
                            if (FILES[file]) {
                                if (FILES[file] === "dir")
                                    log(`cat: ${file}: Is a directory`);
                                else log(FILES[file]);
                            } else {
                                log(`cat: ${file}: No such file or directory`);
                            }
                            break;

                        // --- System Commands ---
                        case "whoami":
                            log("visitor");
                            break;

                        case "status":
                            log(`
<div class="border border-white/10 p-2 rounded bg-white/5 text-white/90">
  <div class="grid grid-cols-[100px_1fr] gap-1">
    <div class="font-bold text-green-400">System:</div><div>${uptimeData.statusText}</div>
    <div class="font-bold text-green-400">SessionID:</div><div>${Math.random().toString(36).slice(2, 11)}</div>
    <div class="font-bold text-green-400">Uptime:</div><div>${uptimeData.uptime}%</div>
    <div class="font-bold text-green-400">Time:</div><div>${new Date().toLocaleTimeString()}</div>
  </div>
</div>`);
                            break;

                        case "neofetch":
                            log(`
<div class="flex gap-6 mt-2 mb-2">
  <div class="text-white/80 font-bold select-none hidden sm:block leading-[1.1] text-xs whitespace-pre">
_____/\\\\\\\\\\\\\\\\\\_________/\\\\\\\\\\\\\\\\\\\\\\\\_        
 ___/\\\\\\\\\\\\\\\\\\\\\\\\\\\______\\\\\\/////\\\\\\\\\///__       
  __/\\\\\\/////////\\\\\\_________\\\\\\/\\\\\\_____      
   _\\\\/\\\\\\_______\\\\/\\\\\\_________\\\\/\\\\\\_____     
    _\\\\/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\_________\\\\/\\\\\\_____    
     _\\\\/\\\\\\/////////\\\\\\_________\\\\/\\\\\\_____   
      _\\\\/\\\\\\_______\\\\/\\\\\\__/\\\\\\___\\\\/\\\\\\_____  
       _\\\\/\\\\\\_______\\\\/\\\\\\_\\\\//\\\\\\\\\\\\\\\\\\______ 
        _\\\\///________\\\\///___\\\\/////////_______  
  </div>
  <div class="flex flex-col justify-center">
    <div>visitor@janach.cloud</div>
    <div class="text-white/20 mb-2">-------------------</div>
    <div>OS: Red Hat Enterprise Linux 9.4</div>
    <div>Host: janach.cloud</div>
    <div>Uptime: ${uptimeData.uptime}%</div>
    <div>Shell: zsh 5.8</div>
    <div>Theme: ant-dark</div>
  </div>
</div>`);
                            break;

                        // --- Content Commands ---
                        case "about":
                            log(`
<div class="inline-flex items-center gap-4 mt-4 mb-4 p-4 border border-white/20 rounded-lg">
    <img src="/profile.png" alt="${terminalData.personalInfo.name}" class="w-16 h-16 rounded-full object-cover">
    <div>
        <div class="text-white font-bold text-base">${terminalData.personalInfo.name}</div>
        <div class="text-gray-400">${terminalData.personalInfo.role}</div>
    </div>
</div>
<div class="text-white leading-relaxed">
    Specialized in high availability and hybrid cloud automation.
    <br>
    Focused on building reliable production platforms using IaC, GitOps, and Kubernetes.
    <br><br>
    Location: ${terminalData.personalInfo.location}
</div>
`);
                            break;

                        case "experience":
                            log(
                                "<span class='text-blue-400 leading-relaxed'>Fetching employment history...</span>",
                            );
                            printLines(EXPERIENCE_CONTENT, 400);
                            break;

                        case "education":
                            log(
                                "<span class='text-blue-400'>Retrieving academic records...</span>",
                            );
                            printLines(EDUCATION_CONTENT, 200);
                            break;

                        case "certificates":
                            log(
                                "<span class='text-blue-400'>Validating credentials...</span>",
                            );
                            printLines(CERTS_CONTENT, 200);
                            break;

                        case "skills":
                            log(
                                "<span class='text-blue-400 italic'>Analyzing skillset...</span>",
                            );
                            trackedTimeout(() => {
                                let skillsHTML = `<div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3 max-w-4xl">`;
                                terminalData.skills.forEach((cat) => {
                                    skillsHTML += `
                <div class="p-2 bg-white/[0.03] border-l border-yellow-400 rounded-r">
                    <div class="text-yellow-300 font-bold text-xs uppercase tracking-widest mb-1">
                        ${cat.label}
                    </div>
                    <div class="text-white/70 text-sm leading-relaxed">
                        ${cat.tech}
                    </div>
                </div>`;
                                });
                                skillsHTML += `</div>`;
                                log(skillsHTML);
                                scrollToBottom();
                            }, 600);
                            break;

                        case "contact":
                            log(
                                "<span class='text-blue-400 italic'>Establishing secure connection...</span>",
                            );
                            trackedTimeout(() => {
                                log(`
<div class="flex flex-wrap gap-3 mt-3 max-w-2xl">
    <a href="mailto:${terminalData.personalInfo.email}" 
       class="flex items-center px-4 py-2 bg-white/[0.03] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 rounded text-white/80 no-underline transition-all active:scale-95">
        <span class="text-sm font-bold tracking-wide">E-mail</span>
    </a>
    <a href="https://${terminalData.personalInfo.linkedin}" target="_blank" rel="noopener noreferrer" 
       class="flex items-center px-4 py-2 bg-white/[0.03] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 rounded text-white/80 no-underline transition-all active:scale-95">
        <span class="text-sm font-bold tracking-wide">LinkedIn</span>
    </a>
</div>
<div class="mt-4 text-xs text-white italic tracking-tight">
    * Connection established. Secure encrypted tunnel ready for messaging.
</div>
`);
                                scrollToBottom();
                            }, 500);
                            break;

                        case "cv":
                            log("<span class='text-blue-400 italic'>Downloading CV...</span>");
                            try {
                                const a = document.createElement('a');
                                a.href = '/Antonio_Janach_CV.pdf';
                                a.download = 'Antonio_Janach_CV.pdf';
                                a.rel = 'noopener noreferrer';
                                document.body.appendChild(a);
                                a.click();
                                document.body.removeChild(a);
                                log("<span class='text-green-400 font-bold'>[OK] Downloading Antonio_Janach_CV.pdf...</span>");
                            } catch (err) {
                                log("<span class='text-red-400 font-bold'>[ERROR] Failed to download CV document.</span>");
                            }
                            scrollToBottom();
                            break;

                        default:
                            log(`zsh: command not found: ${cmd}`);
                            break;
                    }
                }

                function log(html) {
                    if (!output) return;
                    const div = document.createElement("div");
                    div.innerHTML = html;
                    div.className = "mb-1 leading-relaxed";
                    output.appendChild(div);
                }

                // --- Handlers ---

                const toolbarToggleHandler = () => {
                    toolbarContainer?.classList.toggle("toolbar-collapsed");
                    const expanded =
                        !toolbarContainer?.classList.contains(
                            "toolbar-collapsed",
                        );
                    localStorage.setItem(
                        "terminal_toolbar_visible",
                        String(expanded),
                    );
                    toolbarToggle?.setAttribute(
                        "aria-expanded",
                        String(expanded),
                    );
                };

                const contentClickHandler = () => {
                    if (window.getSelection()?.toString() === "") focusInput();
                };

                const toggleHandler = () => {
                    if (overlay.classList.contains("hidden")) openTerminal();
                    else closeTerminal();
                };
                const overlayClickHandler = (e) => {
                    if (e.target === overlay) closeTerminal();
                };
                const windowClickHandler = (e) => {
                    e.stopImmediatePropagation();
                };
                const closeBtnHandler = (e) => {
                    e.stopPropagation();
                    closeTerminal();
                };
                const minimizeBtnHandler = (e) => {
                    e.stopPropagation();
                    minimizeTerminal();
                };
                const maximizeBtnHandler = (e) => {
                    e.stopPropagation();
                    toggleMaximize();
                };
                const keydownHandler = (e) => {
                    if (overlay.classList.contains("hidden")) return;

                    if (e.key === "Escape") {
                        closeTerminal();
                    } else if (
                        e.key.toLowerCase() === "t" &&
                        document.activeElement !== input &&
                        !e.ctrlKey &&
                        !e.altKey &&
                        !e.metaKey
                    ) {
                        // Toggle toolbar with T if input not focused
                        toolbarToggleHandler();
                    }
                };
                const inputHandler = (e) => {
                    if (e.key === "Enter") {
                        const cmdLine = input.value.trim();
                        input.value = "";
                        if (!cmdLine) return;

                        log(
                            `<span class="text-green-400 font-bold">➜</span> <span class="text-blue-400">~ visitor@janach.cloud $</span> ${cmdLine}`,
                        );
                        history.push(cmdLine);
                        historyIndex = history.length;
                        execute(cmdLine);
                        scrollToBottom();
                    } else if (e.key === "ArrowUp") {
                        e.preventDefault();
                        if (historyIndex > 0) {
                            historyIndex--;
                            input.value = history[historyIndex];
                        }
                    } else if (e.key === "ArrowDown") {
                        e.preventDefault();
                        if (historyIndex < history.length - 1) {
                            historyIndex++;
                            input.value = history[historyIndex];
                        } else {
                            historyIndex = history.length;
                            input.value = "";
                        }
                    } else if (e.key === "Tab") {
                        e.preventDefault();
                        const val = input.value.trim().toLowerCase();
                        if (!val) return;
                        const matches = Object.keys(COMMANDS).filter((c) =>
                            c.startsWith(val),
                        );
                        if (matches.length === 1) {
                            input.value = matches[0];
                        } else if (matches.length > 1) {
                            // Find common prefix
                            let prefix = matches[0];
                            for (let i = 1; i < matches.length; i++) {
                                while (!matches[i].startsWith(prefix)) {
                                    prefix = prefix.substring(
                                        0,
                                        prefix.length - 1,
                                    );
                                }
                            }
                            if (input.value === prefix) {
                                log(
                                    `<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-white/80 opacity-80 mt-1 mb-2">${matches.map((m) => `<div>${m}</div>`).join("")}</div>`,
                                );
                                log(
                                    `<span class="text-green-400 font-bold">➜</span> <span class="text-blue-400">~ visitor@janach.cloud $</span> ${input.value}`,
                                );
                                scrollToBottom();
                            } else {
                                input.value = prefix;
                            }
                        }
                    } else if (e.ctrlKey && e.key.toLowerCase() === "c") {
                        e.preventDefault();
                        const cmdLine = input.value;
                        log(
                            `<span class="text-green-400 font-bold">➜</span> <span class="text-blue-400">~ visitor@janach.cloud $</span> ${cmdLine}<span class="text-white">^C</span>`,
                        );
                        input.value = "";
                        scrollToBottom();
                    }
                };

                // Attach
                document.removeEventListener("terminal:toggle", toggleHandler);
                document.addEventListener("terminal:toggle", toggleHandler);

                overlay.removeEventListener("click", overlayClickHandler);
                overlay.addEventListener("click", overlayClickHandler);

                windowEl.removeEventListener("click", windowClickHandler);
                windowEl.addEventListener("click", windowClickHandler);

                closeBtn?.removeEventListener("click", closeBtnHandler);
                closeBtn?.addEventListener("click", closeBtnHandler);

                minimizeBtn?.removeEventListener("click", minimizeBtnHandler);
                minimizeBtn?.addEventListener("click", minimizeBtnHandler);

                maximizeBtn?.removeEventListener("click", maximizeBtnHandler);
                maximizeBtn?.addEventListener("click", maximizeBtnHandler);

                document.removeEventListener("keydown", keydownHandler);
                document.addEventListener("keydown", keydownHandler);

                input.removeEventListener("keydown", inputHandler);
                input.addEventListener("keydown", inputHandler);

                content?.removeEventListener("click", contentClickHandler);
                content?.addEventListener("click", contentClickHandler);

                toolbarToggle?.removeEventListener(
                    "click",
                    toolbarToggleHandler,
                );
                toolbarToggle?.addEventListener("click", toolbarToggleHandler);

                // Universal Command Toolbar Delegation
                const cmdToolbar = document.getElementById("cmd-toolbar");
                const cmdToolbarHandler = (e) => {
                    const target = e.target.closest(".cmd-btn");
                    if (target) {
                        const cmd = target.getAttribute("data-cmd");
                        if (cmd) {
                            input.value = cmd;
                            inputHandler({ key: "Enter" });
                        }
                    }
                };
                cmdToolbar?.removeEventListener("click", cmdToolbarHandler);
                cmdToolbar?.addEventListener("click", cmdToolbarHandler);
            }

            initTerminal();
            document.addEventListener("astro:after-swap", initTerminal);
        </script>
    </div>
</div>
