<button
    id="scroll-to-top"
    aria-label="Back to Top"
    class="fixed bottom-5 right-5 sm:bottom-8 sm:right-8 z-50 hidden size-10 cursor-pointer items-center justify-center opacity-0 translate-y-6 transition-[opacity,transform,background-color,border-color,box-shadow] duration-300 ease-out rounded-full bg-white/80 dark:bg-black/75 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-lg hover:bg-white dark:hover:bg-black/90 hover:border-black/20 dark:hover:border-white/25 hover:shadow-xl group"
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4 stroke-black dark:stroke-white"
    >
        <path d="m18 15-6-6-6 6"></path>
    </svg>
</button>

<style>
    #scroll-to-top:active,
    #scroll-to-top.is-pressed {
        border-color: rgba(255, 255, 255, 0.35) !important;
        background-color: rgba(255, 255, 255, 0.18) !important;
        box-shadow:
            inset 0 2px 5px rgba(0, 0, 0, 0.4),
            0 2px 8px rgba(0, 0, 0, 0.3) !important;
        filter: brightness(1.28) !important;
        scale: 0.88 !important;
        transition: none !important;
    }
</style>

<script is:inline>
    function initScrollToTop() {
        window.__scrollToTopController?.abort();
        window.clearTimeout(window.__scrollToTopHideTimeout);
        const eventController = new AbortController();
        window.__scrollToTopController = eventController;
        const listenerOptions = { signal: eventController.signal };
        const btn = document.getElementById("scroll-to-top");

        if (!btn) return;

        const toggleVisibility = () => {
            if (window.scrollY > 300) {
                window.clearTimeout(window.__scrollToTopHideTimeout);
                btn.classList.remove("hidden", "opacity-0", "translate-y-6");
                btn.classList.add("flex", "opacity-100", "translate-y-0");
            } else {
                btn.classList.remove("opacity-100", "translate-y-0");
                btn.classList.add("opacity-0", "translate-y-6");
                window.__scrollToTopHideTimeout = window.setTimeout(() => {
                    if (window.scrollY <= 300) {
                        btn.classList.remove("flex");
                        btn.classList.add("hidden");
                    }
                }, 300);
            }
            ticking = false;
        };

        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    requestAnimationFrame(toggleVisibility);
                    ticking = true;
                }
            },
            listenerOptions,
        );

        btn.addEventListener(
            "click",
            () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            },
            listenerOptions,
        );

        document.addEventListener(
            "astro:after-swap",
            initScrollToTop,
            listenerOptions,
        );

        // Initial check
        toggleVisibility();
    }

    // Run on initial load and View Transitions navigation
    initScrollToTop();
</script>
