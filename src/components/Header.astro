---
import { LINKS, SOCIALS, SITE } from "@consts";
import { cn } from "@lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
import Container from "@components/Container.astro";
// Removed Terminal import as it has been moved to PageLayout
---

<header id="header" class="fixed top-0 w-full h-16 z-50">
  <Container size="md">
    <div class="header-bar flex items-center justify-between w-full px-3">
      <div class="flex-shrink-0 flex gap-1 font-semibold">
        <a
          id="header-brand-link"
          href="/"
          class="flex items-center gap-1 text-current hover:text-black dark:hover:text-white hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.35)] transition-all duration-200 ease-out"
        >
          <svg class="size-6 fill-current">
            <use href="/brand.svg#brand"></use>
          </svg>
          <div class="font-bold">
            <span class="hidden sm:inline">{SITE.NAME}</span>
            <span class="inline sm:hidden">{SITE.NAME}</span>
          </div>
        </a>
      </div>

      <div class="flex-1 flex justify-center px-3 lg:px-4">
        <nav class="desktop-nav hidden md:flex items-center justify-center text-sm gap-0.5 rounded-lg p-0.5">
          {
            LINKS.map((LINK) => (
              <a
                href={LINK.HREF}
                class={cn(
                  "h-8 rounded-full px-3 text-current",
                  "flex items-center justify-center",
                  "transition-colors duration-200 ease-out",
                  pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
                    ? "bg-white text-black"
                    : "text-white hover:bg-white/15",
                )}
              >
                {LINK.TEXT}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex-shrink-0 flex gap-1 items-center">
        {
          [
            // Search Button
            {
              href: "/search",
              ariaLabel: "Search",
              icon: "search",
              isLink: true,
              id: undefined,
              target: undefined,
              extraClass:
                pathname === "/search" || "/" + subpath?.[0] === "/search"
                  ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black"
                  : "",
            },
            // Socials (LinkedIn, Git - filtered if needed, or matched from SOCIALS)
            ...SOCIALS.filter(
              (s) => s.NAME === "LinkedIn" || s.NAME === "Credly",
            ).map((s) => ({
              href: s.HREF,
              ariaLabel: s.NAME,
              icon: s.ICON,
              isLink: true,
              target: "_blank",
              id: undefined,
              extraClass: undefined,
            })),
            // Terminal Toggle (Button)
            {
              id: "terminal-toggle",
              ariaLabel: "Open Terminal",
              icon: "terminal",
              isLink: false,
              href: undefined,
              target: undefined,
              extraClass: undefined,
            },
          ].map((btn) =>
            btn.isLink ? (
              <a
                href={btn.href}
                target={btn.target}
                aria-label={btn.ariaLabel}
                class={cn(
                  "hidden md:flex",
                  "header-control size-8 rounded-full p-1.5 items-center justify-center",
                  "stroke-current",
                  "border border-transparent",
                  "hover:bg-black/5 dark:hover:bg-white/12",
                  "transition-colors duration-200 ease-out",
                  btn.extraClass,
                )}
              >
                <svg class="size-full fill-current">
                  <use
                    href={`/${btn.icon === "search" ? "ui" : "social"}.svg#${btn.icon}`}
                  />
                </svg>
              </a>
            ) : (
              <button
                id={btn.id}
                aria-label={btn.ariaLabel}
                class={cn(
                  "hidden md:flex",
                  "header-control size-8 rounded-full p-1.5 items-center justify-center",
                  "stroke-current",
                  "border border-transparent",
                  "hover:bg-black/5 dark:hover:bg-white/12",
                  "transition-colors duration-200 ease-out",
                )}
              >
                <svg class="size-full fill-current">
                  <use href={`/social.svg#${btn.icon}`} />
                </svg>
              </button>
            ),
          )
        }

        <button
          id="header-drawer-button"
          aria-label="Open navigation menu"
          aria-controls="drawer"
          aria-expanded="false"
          class={cn(
            "flex md:hidden",
            "header-control size-8 rounded-full p-1.5 items-center justify-center",
            "stroke-current",
            "border border-transparent",
            "hover:bg-black/5 dark:hover:bg-white/12",
            "transition-colors duration-200 ease-out",
          )}
        >
          <svg id="drawer-open" class="size-full">
            <use href="/ui.svg#menu"></use>
          </svg>
          <svg id="drawer-close" class="size-full">
            <use href="/ui.svg#x"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
  <!-- Terminal moved to PageLayout for global stacking context -->

  <style>
    #header-brand-link {
      touch-action: manipulation;
    }

    @media (max-width: 47.999rem) {
      #header-brand-link {
        border-radius: 0.375rem;
        transition:
          transform 100ms ease,
          background-color 120ms ease,
          color 120ms ease,
          box-shadow 120ms ease;
      }

      #header-brand-link:active,
      #header-brand-link.is-pressed {
        background-color: rgba(255, 255, 255, 0.18) !important;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12) !important;
        color: #fff !important;
        transform: scale(0.96) !important;
        transition: none !important;
      }
    }

    #header-drawer-button > #drawer-open {
      @apply block;
    }
    #header-drawer-button > #drawer-close {
      @apply hidden;
    }
    #header-drawer-button.open > #drawer-open {
      @apply hidden;
    }
    #header-drawer-button.open > #drawer-close {
      @apply block;
    }
  </style>

  <script is:inline>
    function setDrawerOpen(open) {
      const drawer = document.getElementById("drawer");
      const drawerButton = document.getElementById("header-drawer-button");
      drawer?.classList.toggle("open", open);
      drawer?.setAttribute("aria-hidden", String(!open));
      drawerButton?.classList.toggle("open", open);
      drawerButton?.setAttribute("aria-expanded", String(open));
      drawerButton?.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );
      document.body.classList.toggle("drawer-open", open);
    }

    function initializeHeaderInteractions() {
      window.__headerEventController?.abort();
      const eventController = new AbortController();
      window.__headerEventController = eventController;
      const listenerOptions = { signal: eventController.signal };

      const brandLink = document.getElementById("header-brand-link");
      const drawerButton = document.getElementById("header-drawer-button");
      const terminalButton = document.getElementById("terminal-toggle");

      const clearBrandLinkPressed = () =>
        brandLink?.classList.remove("is-pressed");
      const clearDrawerButtonPressed = () =>
        drawerButton?.classList.remove("is-pressed");

      brandLink?.addEventListener(
        "pointerdown",
        () => brandLink.classList.add("is-pressed"),
        listenerOptions,
      );
      brandLink?.addEventListener(
        "pointerup",
        clearBrandLinkPressed,
        listenerOptions,
      );
      brandLink?.addEventListener(
        "pointercancel",
        clearBrandLinkPressed,
        listenerOptions,
      );
      brandLink?.addEventListener(
        "pointerleave",
        clearBrandLinkPressed,
        listenerOptions,
      );

      drawerButton?.addEventListener(
        "pointerdown",
        () => drawerButton.classList.add("is-pressed"),
        listenerOptions,
      );
      drawerButton?.addEventListener(
        "pointerup",
        clearDrawerButtonPressed,
        listenerOptions,
      );
      drawerButton?.addEventListener(
        "pointercancel",
        clearDrawerButtonPressed,
        listenerOptions,
      );

      drawerButton?.addEventListener(
        "click",
        () => {
          setDrawerOpen(!drawerButton.classList.contains("open"));
        },
        listenerOptions,
      );

      terminalButton?.addEventListener(
        "click",
        () => {
          const rect = terminalButton.getBoundingClientRect();
          document.dispatchEvent(
            new CustomEvent("terminal:toggle", {
              detail: {
                x: rect.left + rect.width / 2,
                y: rect.top + rect.height / 2,
                returnFocusId: "terminal-toggle",
              },
            }),
          );
        },
        listenerOptions,
      );

      document.addEventListener(
        "astro:after-swap",
        initializeHeaderInteractions,
        listenerOptions,
      );
    }

    initializeHeaderInteractions();
  </script>
</header>
