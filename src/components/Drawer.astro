---
import { SITE, LINKS, SOCIALS } from "@consts";
import { cn } from "@lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<div
  id="drawer"
  class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col items-center justify-center md:hidden bg-neutral-100 dark:bg-neutral-900 transition-[height] duration-300 ease-in-out"
>
  <nav class="flex flex-col items-center space-y-2">
    {
      LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          class={cn(
            "flex items-center justify-center px-3 py-1 rounded-full",
            "text-current hover:text-black dark:hover:text-white",
            "hover:bg-black/5 dark:hover:bg-white/15",
            "transition-colors duration-300 ease-in-out",
            pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
              ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black"
              : "",
          )}
        >
          {LINK.TEXT}
        </a>
      ))
    }
  </nav>

  <div class="flex gap-1 mt-5">
    {
      [
        // Search Button
        {
          href: "/search",
          ariaLabel: "Search",
          icon: "search",
          isLink: true,
          target: undefined,
          id: undefined,
          extraClass:
            pathname === "/search" || "/" + subpath?.[0] === "search"
              ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black"
              : "",
        },
        // Socials
        ...SOCIALS.filter(
          (s) => s.NAME === "LinkedIn" || s.NAME === "Credly",
        ).map((s) => ({
          href: s.HREF,
          ariaLabel: s.NAME,
          icon: s.ICON,
          isLink: true,
          target: "_blank",
          id: undefined,
          extraClass: undefined,
        })),
        // Terminal Toggle
        {
          href: undefined,
          ariaLabel: "Open Terminal",
          icon: "terminal",
          isLink: false,
          target: undefined,
          id: "drawer-terminal-toggle",
          extraClass: undefined,
        },
      ].map((btn) =>
        btn.isLink ? (
          <a
            href={btn.href}
            target={btn.target}
            aria-label={btn.ariaLabel}
            class={cn(
              "size-10 rounded-full p-2 items-center justify-center",
              "stroke-current",
              "border border-transparent",
              "hover:bg-black/5 dark:hover:bg-white/15 hover:scale-110",
              "transition-all duration-300 ease-in-out",
              btn.extraClass,
            )}
          >
            <svg class="size-full fill-current">
              <use
                href={`/${btn.icon === "search" ? "ui" : "social"}.svg#${btn.icon}`}
              />
            </svg>
          </a>
        ) : (
          <button
            id={btn.id}
            aria-label={btn.ariaLabel}
            class={cn(
              "size-10 rounded-full p-2 items-center justify-center",
              "stroke-current",
              "border border-transparent",
              "hover:bg-black/5 dark:hover:bg-white/15 hover:scale-110",
              "transition-all duration-300 ease-in-out",
              btn.extraClass,
            )}
          >
            <svg class="size-full fill-current">
              <use href={`/social.svg#${btn.icon}`} />
            </svg>
          </button>
        ),
      )
    }
  </div>
</div>

<script is:inline>
  function initializeDrawerTerminalButton() {
    const drawerTerminalButton = document.getElementById(
      "drawer-terminal-toggle",
    );
    drawerTerminalButton?.addEventListener("click", () => {
      // Close drawer first
      const drawer = document.getElementById("drawer");
      const drawerButton = document.getElementById("header-drawer-button");
      drawer?.classList.remove("open");
      drawerButton?.classList.remove("open");

      // Then toggle terminal
      setTimeout(() => {
        document.dispatchEvent(new Event("terminal:toggle"));
      }, 100);
    });
  }

  document.addEventListener("astro:after-swap", initializeDrawerTerminalButton);
  initializeDrawerTerminalButton();
</script>

<style>
  #drawer.open {
    @apply h-full;
  }
</style>
