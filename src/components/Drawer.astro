---
import { LINKS, SOCIALS } from "@consts";
import { cn } from "@lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<div
  id="drawer"
  class="fixed inset-0 z-40 md:hidden"
  aria-hidden="true"
>
  <button
    id="drawer-backdrop"
    class="absolute inset-0 h-full w-full"
    aria-label="Close navigation menu"
  ></button>

  <div class="drawer-sheet absolute inset-x-5 top-[4.5rem] mx-auto max-w-screen-sm">
    <div class="drawer-navigation px-2 pt-2 pb-1">
      <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-white/40">
        Navigation
      </p>
      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {
          LINKS.map((LINK) => {
            const isActive =
              pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF;

            return (
              <a
                href={LINK.HREF}
                aria-current={isActive ? "page" : undefined}
                class={cn(
                  "drawer-nav-link flex min-h-11 items-center justify-between rounded-lg px-3 text-[15px] font-medium",
                  "transition-colors duration-150 ease-out",
                  isActive
                    ? "pointer-events-none bg-white text-black"
                    : "text-white/80 hover:bg-white/10 hover:text-white",
                )}
              >
                <span>{LINK.TEXT}</span>
                <span
                  class={cn(
                    "size-1.5 rounded-full",
                    isActive ? "bg-black/60" : "bg-white/20",
                  )}
                  aria-hidden="true"
                />
              </a>
            );
          })
        }
      </nav>
    </div>

    <div class="mx-3 border-t border-white/10"></div>

    <div class="grid grid-cols-4 gap-1 p-2">
      {
        [
          {
            href: "/search",
            label: "Search",
            icon: "search",
            isLink: true,
            target: undefined,
            id: undefined,
          },
          ...SOCIALS.filter(
            (social) =>
              social.NAME === "LinkedIn" || social.NAME === "Credly",
          ).map((social) => ({
            href: social.HREF,
            label: social.NAME,
            icon: social.ICON,
            isLink: true,
            target: "_blank",
            id: undefined,
          })),
          {
            href: undefined,
            label: "Terminal",
            icon: "terminal",
            isLink: false,
            target: undefined,
            id: "drawer-terminal-toggle",
          },
        ].map((control) =>
          control.isLink ? (
            <a
              href={control.href}
              target={control.target}
              rel={control.target ? "noopener noreferrer" : undefined}
              aria-label={control.label}
              class="drawer-utility flex min-w-0 flex-col items-center gap-1.5 rounded-lg px-1 py-2 text-white/65 transition-colors duration-150 hover:bg-white/10 hover:text-white"
            >
              <span class="flex size-8 items-center justify-center rounded-lg bg-white/10 p-1.5 shadow-inner">
                <svg
                  class={cn(
                    "size-full fill-current",
                    control.icon === "search" && "stroke-current",
                  )}
                >
                  <use
                    href={`/${control.icon === "search" ? "ui" : "social"}.svg#${control.icon}`}
                  />
                </svg>
              </span>
              <span class="w-full truncate text-center text-[10px] font-medium">
                {control.label}
              </span>
            </a>
          ) : (
            <button
              id={control.id}
              aria-label={control.label}
              class="drawer-utility flex min-w-0 flex-col items-center gap-1.5 rounded-lg px-1 py-2 text-white/65 transition-colors duration-150 hover:bg-white/10 hover:text-white"
            >
              <span class="flex size-8 items-center justify-center rounded-lg bg-white/10 p-1.5 shadow-inner">
                <svg class="size-full fill-current">
                  <use href={`/social.svg#${control.icon}`} />
                </svg>
              </span>
              <span class="w-full truncate text-center text-[10px] font-medium">
                {control.label}
              </span>
            </button>
          ),
        )
      }
    </div>
  </div>
</div>

<script is:inline>
  function closeNavigationDrawer() {
    const drawer = document.getElementById("drawer");
    const drawerButton = document.getElementById("header-drawer-button");
    drawer?.classList.remove("open");
    drawer?.setAttribute("aria-hidden", "true");
    drawerButton?.classList.remove("open");
    drawerButton?.setAttribute("aria-expanded", "false");
    drawerButton?.setAttribute("aria-label", "Open navigation menu");
    document.body.classList.remove("drawer-open");
  }

  function initializeDrawerInteractions() {
    window.__drawerEventController?.abort();
    const eventController = new AbortController();
    window.__drawerEventController = eventController;
    const listenerOptions = { signal: eventController.signal };

    const drawerTerminalButton = document.getElementById(
      "drawer-terminal-toggle",
    );
    const drawerBackdrop = document.getElementById("drawer-backdrop");
    const pressedControls = document.querySelectorAll(
      "#drawer .drawer-nav-link:not([aria-current='page']), #drawer .drawer-utility",
    );

    pressedControls.forEach((control) => {
      const clearPressed = () => control.classList.remove("is-pressed");
      control.addEventListener(
        "pointerdown",
        () => control.classList.add("is-pressed"),
        listenerOptions,
      );
      control.addEventListener("pointerup", clearPressed, listenerOptions);
      control.addEventListener("pointercancel", clearPressed, listenerOptions);
      control.addEventListener("pointerleave", clearPressed, listenerOptions);
    });

    drawerBackdrop?.addEventListener(
      "click",
      closeNavigationDrawer,
      listenerOptions,
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeNavigationDrawer();
        }
      },
      listenerOptions,
    );

    drawerTerminalButton?.addEventListener(
      "click",
      () => {
        const rect = drawerTerminalButton.getBoundingClientRect();
        const origin = {
          x: rect.left + rect.width / 2,
          y: rect.top + rect.height / 2,
          returnFocusId: "header-drawer-button",
        };

        closeNavigationDrawer();

        setTimeout(() => {
          document.dispatchEvent(
            new CustomEvent("terminal:toggle", { detail: origin }),
          );
        }, 180);
      },
      listenerOptions,
    );

    document.addEventListener(
      "astro:after-swap",
      initializeDrawerInteractions,
      listenerOptions,
    );
  }

  initializeDrawerInteractions();
</script>
