---
interface Props {
  items: {
    date: string;
    title: string;
    company: string;
    points?: string[];
    link?: string;
  }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col space-y-0">
  {
    items.map((item) => (
      <div class="timeline-item opacity-0 translate-y-4 transition-all duration-700 ease-out relative group md:grid md:grid-cols-[180px_1fr] md:gap-8">
        <!-- Date (Desktop) -->
        <div class="hidden md:flex flex-col items-end pt-1 flex-shrink-0">
             <span class="text-sm font-mono font-medium text-neutral-500 uppercase tracking-widest text-right whitespace-nowrap">
                {item.date}
             </span>
        </div>

        <!-- Timeline Line & Dot Container -->
        <div class="relative pl-8 pb-12 border-l border-neutral-300 dark:border-neutral-800 md:col-start-2">
            <!-- Filling Line -->
            <div class="timeline-line-fill absolute top-0 left-[-1px] w-[1px] h-full bg-neutral-900 dark:bg-neutral-100 origin-top scale-y-0 transition-transform duration-1000 ease-out"></div>

            <!-- Dot -->
            <span class="absolute top-2 -left-[5px] h-2.5 w-2.5 rounded-full bg-neutral-400 dark:bg-neutral-600 ring-4 ring-white dark:ring-neutral-950 transition-colors duration-300 group-hover:bg-black dark:group-hover:bg-white z-10"></span>
            
            <!-- Content -->
            <div class="flex flex-col items-start gap-2 relative">
                 <!-- Date (Mobile) -->
                <span class="md:hidden text-xs font-mono font-medium text-neutral-500 uppercase tracking-widest mb-1">
                    {item.date}
                </span>

                <div class="space-y-0.5">
                    <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
                        {item.link ? (
                            <a href={item.link} target="_blank" rel="noopener noreferrer" class="hover:underline decoration-neutral-400 underline-offset-4">
                                {item.title}
                            </a>
                        ) : (
                            item.title
                        )}
                    </h3>
                    <h4 class="text-base font-medium text-neutral-600 dark:text-neutral-400">
                        {item.company}
                    </h4>
                </div>
                
                {item.points && item.points.length > 0 && (
                    <ul class="list-disc list-outside ml-4 space-y-1 mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed marker:text-neutral-300 dark:marker:text-neutral-600">
                        {item.points.map(point => (
                            <li set:html={point} />
                        ))}
                    </ul>
                )}
            </div>
        </div>
      </div>
    ))
  }
</div>

<script>
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // Fade in item
                entry.target.classList.remove('opacity-0', 'translate-y-4');
                entry.target.classList.add('opacity-100', 'translate-y-0');
                
                // Animate line fill
                const line = entry.target.querySelector('.timeline-line-fill');
                if (line) {
                    (line as HTMLElement).style.transform = 'scaleY(1)';
                }

                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    document.querySelectorAll('.timeline-item').forEach(item => {
        observer.observe(item);
    });
</script>
