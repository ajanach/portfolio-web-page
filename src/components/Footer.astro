---
import { SITE, SOCIALS, CURRENT_YEAR } from "@consts";
import Container from "@components/Container.astro";

interface Props {
  uptime: string | null;
  statusText: string;
  statusClass: string;
}

const { uptime, statusText, statusClass } = Astro.props;
---

<footer class="relative bg-transparent">
  <div>
    <div class="h-10" aria-hidden="true"></div>

    <section
      class="footer-surface py-5 overflow-hidden whitespace-nowrap border-t border-black/10 dark:border-white/10 relative z-20"
    >
      <Container size="md">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex flex-col items-center sm:items-start">
            <a
              href="/"
              data-pressable="true"
              class="footer-brand-link flex gap-1 w-fit font-semibold text-current hover:text-black dark:hover:text-white hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.25)] transition-[color,filter] duration-200 ease-out"
            >
              <svg class="size-6 fill-current">
                <use href="/brand.svg#brand"></use>
              </svg>
              {SITE.NAME}
            </a>
          </div>

          <!-- Uptime Status with Real Data -->
          <a
            href="https://stats.uptimerobot.com/K4iCg2UIEi"
            data-pressable="true"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View detailed uptime status"
            class="flex gap-2 justify-center sm:justify-end items-center text-current hover:text-black dark:hover:text-white transition-colors duration-300 group"
          >
            <span class="relative flex h-3 w-3">
              <span
                class:list={[
                  "animate-ping absolute inline-flex h-full w-full rounded-full transition-colors",
                  statusClass === "success" &&
                    "bg-green-300 group-hover:bg-green-400",
                  statusClass === "warning" &&
                    "bg-yellow-300 group-hover:bg-yellow-400",
                  statusClass === "danger" &&
                    "bg-red-300 group-hover:bg-red-400",
                ]}></span>
              <span
                class:list={[
                  "relative inline-flex rounded-full h-3 w-3 transition-colors",
                  statusClass === "success" &&
                    "bg-green-500 group-hover:bg-green-400",
                  statusClass === "warning" &&
                    "bg-yellow-500 group-hover:bg-yellow-400",
                  statusClass === "danger" &&
                    "bg-red-500 group-hover:bg-red-400",
                ]}></span>
            </span>
            <span
              class="flex items-center gap-1.5 text-xs sm:text-sm font-medium"
            >
              <span>{statusText}</span>
              <span
                class="flex items-center gap-1.5 max-w-0 opacity-0 group-hover:max-w-[100px] group-hover:opacity-100 transition-all duration-500 ease-in-out overflow-hidden"
              >
                <span class="opacity-40 select-none">Uptime:</span>
                <span
                  class="font-mono font-bold text-green-500 dark:text-green-400"
                >
                  {uptime === null ? "Unavailable" : `${uptime}%`}
                </span>
              </span>
            </span>
          </a>
        </div>
      </Container>
    </section>

    <section
      class="footer-surface py-5 overflow-hidden whitespace-nowrap border-t border-black/10 dark:border-white/10 relative z-20"
    >
      <Container size="md">
        <div class="h-full grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div
            class="order-2 sm:order-1 flex flex-col items-center justify-center sm:items-start"
          >
            <div class="legal">
              <a
                href="/legal/terms"
                data-pressable="true"
                class="footer-legal-link inline-block rounded px-1 -mx-1 text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
              >
                Terms
              </a> |
              <a
                href="/legal/privacy"
                data-pressable="true"
                class="footer-legal-link inline-block rounded px-1 -mx-1 text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
              >
                Privacy
              </a>
            </div>
            <div class="text-sm mt-2">
              &copy; {CURRENT_YEAR} | All rights reserved
            </div>
          </div>

          <div class="order-1 sm:order-2 flex justify-center sm:justify-end">
            <div class="flex flex-wrap gap-1 items-center justify-center">
              {
                SOCIALS.map((SOCIAL) => (
                  <a
                    href={SOCIAL.HREF}
                    data-pressable="true"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                    class="footer-social-link group flex size-9 rounded-full p-2 items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-200"
                  >
                    <svg class="size-full fill-current group-hover:fill-black group-hover:dark:fill-white blend">
                      <use href={`/social.svg#${SOCIAL.ICON}`} />
                    </svg>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </Container>
    </section>
  </div>
</footer>

<style>
  .footer-legal-link:active,
  .footer-legal-link.is-pressed {
    background-color: rgba(255, 255, 255, 0.16) !important;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1) !important;
    filter: brightness(1.35) !important;
    scale: 0.9 !important;
    transition: none !important;
  }

  .footer-social-link:active,
  .footer-social-link.is-pressed {
    background-color: rgba(255, 255, 255, 0.22) !important;
    box-shadow:
      inset 0 1px 3px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.14) !important;
    filter: brightness(1.4) !important;
    scale: 0.84 !important;
    transition: none !important;
  }
</style>
